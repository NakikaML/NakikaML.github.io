---
import '../styles/global.css';
// ⚠️ katex 的版本必须与 rehype-katex 内部用的那份保持一致（都留在 0.16.x）：
//    公式的 HTML 是 rehype-katex 用它自带的 katex 生成的（类名如 class="sizing"），
//    这里加载的却是本项目 node_modules/katex 的 CSS。
//    0.18 把这些类名改成了 katex-sizing —— 两边一旦错开，121 条字号缩放规则
//    （上下标 70%、文本式分式 90%……）会全部失效，公式整体"变大变挤"。
//    所以 package.json 里锁的是 katex ^0.16.47，不要单独 pnpm up katex。
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';

interface Props {
  /** 页面标题；不传则用站点默认 */
  title?: string;
  description?: string;
  /** 传 true 时 title 不再拼站点名（首页用） */
  fullTitle?: boolean;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = site.description,
  fullTitle = false,
  ogType = 'website',
} = Astro.props;

const pageTitle = title
  ? fullTitle
    ? title
    : `${title} · ${site.name}`
  : `${site.name} · 学习笔记与作品集`;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com');
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* 站点图标由 scripts/build-avatar.mjs 从 src/assets/avatar.png 生成（换图后重跑 pnpm run avatar） */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      site.links.rss && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={`${site.name} · RSS`}
          href={site.links.rss}
        />
      )
    }

    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      // Mermaid 图按需渲染：只有页面里真的出现 ```mermaid 才加载这个重依赖
      (async () => {
        /**
         * 找出所有 mermaid 代码块。
         *
         * ⚠️ 这里踩过一次坑：Astro 的 Shiki 集成会把语言写在
         *      <pre data-language="mermaid"> 上，并把 <code> 上的 language-* 类**去掉**。
         *    所以只查 `code.language-mermaid` 永远是 0 个，脚本会在下面提前 return，
         *    页面上只剩一个灰色代码块（这个 bug 一直没暴露，是因为之前的笔记里没有 mermaid 图）。
         *    两种标记都认，避免以后再被上游换写法坑一次。
         */
        const hosts = new Set();
        document.querySelectorAll('pre[data-language="mermaid"]').forEach((pre) => hosts.add(pre));
        document.querySelectorAll('code.language-mermaid').forEach((code) => {
          hosts.add(code.closest('pre') ?? code);
        });

        const blocks = [...hosts];
        if (blocks.length === 0) return;

        // 把代码块换成一个空的 .mermaid 容器，交给 mermaid 渲染。
        // 连「语言标签 + 复制按钮」那层壳一起换掉——图不需要复制按钮。
        // 同时记下原节点：渲染失败时放回去，总比留一片空白强。
        const swapped = [];
        for (const block of blocks) {
          const wrapper = block.closest('.code-block') ?? block;
          const div = document.createElement('div');
          div.className = 'mermaid';
          div.textContent = (block.querySelector('code') ?? block).textContent ?? '';
          wrapper.replaceWith(div);
          swapped.push({ div, wrapper });
        }

        try {
          const { default: mermaid } = await import('mermaid');

          /**
           * ⚠️ 必须先把用到的图表模块**静态注册**好，再交给 mermaid.run()。
           *
           * 为什么：mermaid v12 的 37 种图表全部是「懒加载模块」——
           *   mermaid.core.mjs 里写的是 `import("./chunks/mermaid.core/flowDiagram-xxx.mjs")`，
           *   要等 detectType 认不出类型时才在**运行时**去 import 那一个 chunk。
           * 这套机制在 Vite 打包产物里是**静默失效**的：detectType 第一轮认不出类型 →
           *   走懒加载 → 那一步失败 → render 抛错 → 被下面的 catch 吞掉 →
           *   页面「稳定地」回退成灰色代码块，控制台之外看不出任何异常。
           * 这里直接把这个 chunk 静态 import 进来并注册，detectType 第一轮就命中，
           *   不再依赖任何运行时 import，所以渲染是确定的。
           *
           * 本站 23 张图**全部是 flowchart**（含 `graph` 写法），所以只注册这一个。
           * 以后要加别的图型（sequence／class／state…），照抄下面两行、换掉 chunk 路径即可。
           *
           * 关于那串 hash：`flowDiagram-KWPJA3E3.mjs` 是 mermaid 内部的 chunk 名，
           *   升级 mermaid 后可能变。届时构建会**直接报错**（import 解析不到）而不是悄悄坏掉，
           *   把路径换成 node_modules/mermaid/dist/chunks/mermaid.core/ 下的新文件名即可。
           */
          const { diagram: flowDiagram } = await import(
            'mermaid/dist/chunks/mermaid.core/flowDiagram-KWPJA3E3.mjs'
          );
          mermaid.registerExternalDiagrams([
            {
              id: 'flowchart-v2',
              detector: (txt) => /^\s*(graph|flowchart)/.test(txt),
              loader: async () => ({ id: 'flowchart-v2', diagram: flowDiagram }),
              lazyLoad: false,
            },
          ]);

          const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          mermaid.initialize({
            startOnLoad: false,
            theme: dark ? 'dark' : 'neutral',
            securityLevel: 'loose',
          });
          await mermaid.run({ querySelector: '.mermaid' });
        } catch (err) {
          // 渲染失败：把原始代码块放回去，并换成一句能看懂的提示
          swapped.forEach(({ div, wrapper }) => div.replaceWith(wrapper));
          // 把真正的报错信息也带出来——只打整个对象的话，控制台里往往只看到
          // 「Promise {<rejected>}」或一个没用的 stack，排查时抓不住重点。
          const detail =
            err instanceof Error ? `${err.name}: ${err.message}` : String(err);
          console.warn(`Mermaid 渲染失败，已回退为源码块 —— ${detail}`, err);
        }
      })();
    </script>

    <script>
      // 代码块右上角的「复制」按钮（标记由 scripts/rehype-code-meta.mjs 生成）。
      // 事件委托：一段脚本管全站所有代码块，不随内容增加而变重。
      document.addEventListener('click', async (event) => {
        const target = event.target;
        const btn = target instanceof Element ? target.closest('[data-code-copy]') : null;
        if (!btn) return;

        const pre = btn.closest('.code-block')?.querySelector('pre');
        if (!pre) return;

        // 用 textContent 而不是 innerText：拿到的是原始代码，不受折行影响
        const code = (pre.textContent ?? '').replace(/\n$/, '');
        const original = btn.textContent;
        const settle = (label) => {
          btn.textContent = label;
          btn.classList.add('is-done');
          setTimeout(() => {
            btn.textContent = original;
            btn.classList.remove('is-done');
          }, 1600);
        };

        try {
          await navigator.clipboard.writeText(code);
          settle('已复制');
        } catch {
          // http:// 或很旧的浏览器没有 clipboard API，如实反馈而不是假装成功
          settle('复制失败');
        }
      });
    </script>
    <script>
      // 正文图片点击放大（bug-5 / opinion-9）。
      // 标记由 scripts/rehype-image-figure.mjs 生成：figure 里那个「放大」按钮带
      // data-img-zoom，夹在文字里的图片则只有 data-zoomable（点图片本身即可）。
      //
      // <dialog> 全站只建一个、且首次用到才建：每张图各配一份隐藏的浮层
      // 会让 dsa-6 这种 31 张图的页面白背一堆 DOM。
      (() => {
        let dialog = null;

        function ensureDialog() {
          if (dialog) return dialog;

          dialog = document.createElement('dialog');
          dialog.className = 'img-zoom';
          dialog.setAttribute('aria-label', '放大查看图片');

          const inner = document.createElement('div');
          inner.className = 'img-zoom__inner';

          const close = document.createElement('button');
          close.type = 'button';
          close.className = 'img-zoom__close';
          close.setAttribute('data-img-zoom-close', '');
          close.textContent = '关闭 ✕';

          const big = document.createElement('img');
          big.className = 'img-zoom__img';
          big.alt = '';

          // alt 顺手当图注显示：笔记里的 alt 本来就是「BFS 遍历过程（一）」这种说明
          const cap = document.createElement('p');
          cap.className = 'img-zoom__cap';

          inner.append(close, big, cap);
          dialog.append(inner);
          document.body.append(dialog);

          // 点遮罩（事件目标是 dialog 自己）关闭；Esc 由 <dialog> 原生处理
          dialog.addEventListener('click', (event) => {
            if (event.target === dialog) dialog.close();
          });
          close.addEventListener('click', () => dialog.close());
          // 关闭后清掉 src：原图可能有好几百 KB，别一直挂在 DOM 上
          dialog.addEventListener('close', () => {
            big.removeAttribute('src');
          });

          return dialog;
        }

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          // 关闭按钮由 ensureDialog 里那两行单独管，别在这里二次处理
          if (target.closest('[data-img-zoom-close]')) return;

          const btn = target.closest('[data-img-zoom]');
          // 点图片本身也能放大；但如果图片外面套着链接（[![alt](img)](url)），
          // 点图应该走链接 —— 想让那种图放大就点右上角那个按钮。
          const img =
            !btn &&
            target instanceof HTMLImageElement &&
            target.matches('[data-zoomable]') &&
            !target.closest('a')
              ? target
              : null;
          if (!btn && !img) return;

          const src = (btn?.getAttribute('data-img-zoom') || img?.getAttribute('src') || '').trim();
          if (!src) return;

          const d = ensureDialog();
          const big = d.querySelector('.img-zoom__img');
          const cap = d.querySelector('.img-zoom__cap');
          const alt = btn?.getAttribute('data-img-alt') || img?.getAttribute('alt') || '';

          if (big) {
            big.src = src;
            big.alt = alt;
          }
          if (cap) cap.textContent = alt;

          d.showModal();
        });
      })();
    </script>
  </body>
</html>

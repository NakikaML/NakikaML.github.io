---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { contentNotes, countByCategory, countByTag, SHOW_DRAFTS } from '../../utils/notes';

const notes = await contentNotes();
const cats = countByCategory(notes);
// 开发服务器里草稿也在 notes 里（见 utils/notes.ts 的 SHOW_DRAFTS）；
// 构建时这里是 0，提示条也就不会出现。
const draftCount = notes.filter((n) => n.data.draft).length;
// 标签按出现次数排序。默认只露前 12 个，其余的折叠在「全部标签」后面（opinion-6）：
// 以前这里只列出现次数 >= 3 的所谓「热门标签」，冷门标签根本没有入口。
const TAGS_VISIBLE = 12;
const tags = countByTag(notes, 1);
const extraTags = Math.max(0, tags.length - TAGS_VISIBLE);
const hasNotes = notes.length > 0;
---

<BaseLayout
  title="学习笔记"
  description={
    hasNotes
      ? `共 ${notes.length} 篇笔记，支持按分类筛选、按标签过滤与关键词搜索。`
      : '这里会陆续放上我重构整理过的笔记。'
  }
>
  <div class="wrap">
    <div class="page-head page-head--row">
      <div>
        <p class="page-head__kicker">Notes</p>
        <h1>学习笔记</h1>
        <p class="page-head__lede">
          {
            hasNotes
              ? `共 ${notes.length} 篇。都是我重新整理、为公开阅读写过的内容，不是私人笔记的搬运。支持按分类筛选、按标签过滤和关键词搜索。`
              : '这里会陆续放上我重构整理过的笔记。我的私人知识库不直接对外，放上来的每一篇都会重写一遍——把当时的速记、跳步和只有自己看得懂的缩写补成完整的讲解。'
          }
        </p>
      </div>
      {
        hasNotes && (
          <a class="graph-entry" href="/notes/graph/" title="按「先学 → 后学」的依赖看全部笔记">
            <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true" fill="none"
              stroke="currentColor" stroke-width="1.6">
              <circle cx="5" cy="5" r="2.4" />
              <circle cx="15" cy="7" r="2.4" />
              <circle cx="8" cy="15" r="2.4" />
              <path d="M7.2 6.1 12.8 6.7M6.2 7.2l1.3 5.4M13.8 9.1l-4.4 4.2" />
            </svg>
            知识图谱
            <span class="graph-entry__count">{notes.length}</span>
          </a>
        )
      }
    </div>

    {
      SHOW_DRAFTS && draftCount > 0 && (
        <div class="dev-hint">
          <strong>开发模式</strong>
          <span>
            当前列表里的 <strong>{draftCount}</strong> 篇带「草稿」徽章，是
            <code>draft: true</code> 的笔记。它们<strong>只在这台开发服务器上可见</strong>——
            <code>pnpm build</code> / <code>pnpm release</code> 不会把它们放进网站，
            访客的列表页、详情页和 RSS 里都没有。想按线上视角确认一遍，用
            <code>pnpm build</code> 加 <code>pnpm preview</code>。
          </span>
        </div>
      )
    }

    {
      !hasNotes && (
        <div class="empty" style="text-align:left;padding:2rem">
          <p style="margin:0 0 0.75rem;color:var(--text-muted)">
            <strong style="color:var(--text)">目前还没有内容。</strong>
            这是有意为之，不是出错了。
          </p>
          <p style="margin:0;color:var(--text-faint);font-size:0.875rem;line-height:1.9">
            笔记正在陆续重构中。想先看点别的？<a href="/blog/">去看博客</a>
            · <a href="/works/">看看作品</a> · <a href="/projects/">看看项目</a>
          </p>
        </div>
      )
    }

    {hasNotes && (
      <>
    <!-- ------------------------------------------------ 筛选 -->
    <div class="filters" id="cat-filters">
      <button type="button" class="is-active" data-cat="">全部 ({notes.length})</button>
      {
        cats.map((c) => (
          <button type="button" data-cat={c.name}>
            {c.name} ({c.count})
          </button>
        ))
      }
    </div>

    {
      tags.length > 0 && (
        <div class="filters" id="tag-filters" style="border-bottom:0;padding-bottom:0;margin-bottom:1rem">
          <span style="font-size:0.8rem;color:var(--text-faint);align-self:center;margin-right:0.25rem">
            标签
          </span>
          {tags.map((t, i) => (
            <button
              type="button"
              data-tag={t.name}
              class={i >= TAGS_VISIBLE ? 'is-extra' : ''}
              hidden={i >= TAGS_VISIBLE}
            >
              {t.name} ({t.count})
            </button>
          ))}
          {extraTags > 0 && (
            <button type="button" id="tag-toggle" class="filters__more" aria-expanded="false">
              全部标签（+{extraTags}）
            </button>
          )}
        </div>
      )
    }

    <div style="margin:0 0 2rem">
      <input
        type="search"
        id="q"
        placeholder="搜索标题、标签…"
        autocomplete="off"
        style="width:100%;max-width:420px;padding:0.6rem 0.9rem;border:1px solid var(--border);border-radius:8px;background:var(--bg-elevated);color:var(--text);font-family:inherit;font-size:0.9rem"
      />
    </div>

    <p id="result-count" style="font-size:0.85rem;color:var(--text-faint);margin-bottom:1.25rem"></p>

    <!-- ------------------------------------------------ 列表 -->
    <div class="grid" id="note-grid">
      {
        notes.map((note) => (
          <div
            class="note-item"
            data-cat={note.data.category}
            data-tags={(note.data.tags ?? []).join('|')}
            data-search={`${note.data.title} ${note.data.category} ${(note.data.tags ?? []).join(' ')} ${note.data.subject} ${note.data.subfield}`.toLowerCase()}
          >
            <NoteCard note={note} showExcerpt />
          </div>
        ))
      }
    </div>

    <div class="empty" id="no-result" style="display:none">
      没有匹配的笔记，换个关键词试试。
    </div>
      </>
    )}
  </div>

  <script>
    const items = Array.from(document.querySelectorAll<HTMLElement>('.note-item'));
    const catBtns = Array.from(document.querySelectorAll<HTMLElement>('#cat-filters button'));
    // 数组本身可变：从笔记页点「?tag=xxx」跳进来时，标签列表里可能没有这个标签，
    // 这时会临时补一个按钮（见 ensureTagButton）。
    // 只取带 data-tag 的按钮 —— 「全部标签」那个开关也在同一个容器里，别混进来。
    const tagBtns = Array.from(
      document.querySelectorAll<HTMLElement>('#tag-filters button[data-tag]')
    );
    const tagToggle = document.getElementById('tag-toggle');
    const collapsedLabel = tagToggle?.textContent?.trim() ?? '';
    const q = document.getElementById('q') as HTMLInputElement | null;
    const counter = document.getElementById('result-count');
    const noResult = document.getElementById('no-result');

    // 支持从首页 / 笔记页直接跳进来：/notes/?cat=计算机科学&tag=数据结构
    const params = new URLSearchParams(location.search);
    let activeCat = params.get('cat') ?? '';
    let activeTag = params.get('tag') ?? '';

    /** 标签 → 篇数（只在临时补按钮时用得上） */
    function countTag(tag: string): number {
      return items.filter((el) => (el.dataset.tags ?? '').split('|').includes(tag)).length;
    }

    /** 点标签：再点一次同一个就取消 */
    function pickTag(t: string) {
      activeTag = activeTag === t ? '' : t;
      tagBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.tag === activeTag));
      // 折叠状态下也要看得见「当前筛的是哪个标签」，否则等于没有取消入口
      if (activeTag) ensureTagButton(activeTag);
      apply();
      syncUrl();
    }

    /** 展开 / 收起被折叠的冷门标签（opinion-6） */
    function setTagsExpanded(expanded: boolean) {
      for (const b of tagBtns) {
        if (!b.classList.contains('is-extra')) continue;
        // 收起时留住正处于选中状态的那一个，不然筛完就看不见自己在筛什么了
        b.hidden = expanded ? false : !b.classList.contains('is-active');
      }
      if (tagToggle) {
        tagToggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        tagToggle.textContent = expanded ? '收起标签' : collapsedLabel;
      }
    }

    /**
     * 标签列表默认只露前 12 个，笔记页的标签链接却可能是被折叠起来的冷门标签。
     * 这时候把它露出来 / 补一个按钮 —— 否则筛是筛了，页面上既看不出筛了什么，也没有取消的入口。
     */
    function ensureTagButton(tag: string) {
      if (!tag) return;
      const found = tagBtns.find((b) => b.dataset.tag === tag);
      if (found) {
        found.hidden = false;
        return;
      }
      const host = document.getElementById('tag-filters');
      if (!host) return;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.dataset.tag = tag;
      btn.textContent = `${tag} (${countTag(tag)})`;
      btn.classList.add('is-active');
      btn.addEventListener('click', () => pickTag(tag));
      // 插在「全部标签」开关之前，临时按钮不会跑到开关后面去
      if (tagToggle) host.insertBefore(btn, tagToggle);
      else host.appendChild(btn);
      tagBtns.push(btn);
    }

    /** 让 URL 跟着筛选走，刷新和分享都能停在同一批结果上 */
    function syncUrl() {
      const p = new URLSearchParams();
      if (activeCat) p.set('cat', activeCat);
      if (activeTag) p.set('tag', activeTag);
      const qs = p.toString();
      history.replaceState(null, '', qs ? `${location.pathname}?${qs}` : location.pathname);
    }

    function apply() {
      const kw = (q?.value ?? '').trim().toLowerCase();
      let shown = 0;

      for (const el of items) {
        const catOk = !activeCat || el.dataset.cat === activeCat;
        const tagOk = !activeTag || (el.dataset.tags ?? '').split('|').includes(activeTag);
        const kwOk = !kw || (el.dataset.search ?? '').includes(kw);
        const ok = catOk && tagOk && kwOk;
        el.style.display = ok ? '' : 'none';
        if (ok) shown++;
      }

      if (counter) counter.textContent = `显示 ${shown} / ${items.length} 篇`;
      if (noResult) noResult.style.display = shown === 0 ? '' : 'none';
    }

    // 先把 URL 里的筛选状态同步到界面上，再渲染一次
    if (activeCat) {
      catBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.cat === activeCat));
    }
    if (activeTag) {
      ensureTagButton(activeTag);
      tagBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.tag === activeTag));
    }

    catBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCat = btn.dataset.cat ?? '';
        catBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
        apply();
        syncUrl();
      });
    });

    tagBtns.forEach((btn) => {
      btn.addEventListener('click', () => pickTag(btn.dataset.tag ?? ''));
    });

    tagToggle?.addEventListener('click', () => {
      setTagsExpanded(tagToggle.getAttribute('aria-expanded') !== 'true');
    });

    q?.addEventListener('input', apply);
    apply();
  </script>
</BaseLayout>

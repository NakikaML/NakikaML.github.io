---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contentNotes } from '../../utils/notes';
import { courses, courseDeps, draftTitles, shortTitle } from '../../data/curriculum';

/**
 * 知识图谱 /notes/graph/
 * ============================================================
 * 一张**有向**的依赖图：箭头表示「先学 → 后学」。
 *
 * 为什么不做成标签关系网：标签是无向的，笔记一多每个节点都会被扯上好几根线，
 * 图会迅速变成一团毛线；而依赖是稀疏的、有向的、有因果的，正好也是读者真正
 * 需要的那条信息 —— 该按什么顺序学。
 *
 * 形态：
 *   · 每门课是一个「课程节点」；点击展开成该课的各章笔记，再点收起。
 *   · 一次只展开一门（可「全部展开」），未展开的课缩成一个节点。
 *   · 章与章之间、课程与课程之间都按 src/data/curriculum.ts 里的依赖画箭头。
 *
 * 零第三方依赖：布局是手算的网格（课程成列、同课程内按依赖深度排纵向位置），
 * 拖动/自适应时再跑一小段「位置约束松弛」（边当弹簧拉近 + 节点间最短距离推开），
 * 既不会散架，也不会互相压住。
 */

const notes = await contentNotes();
const published = new Map(notes.map((n) => [n.id, n]));

/** 只保留「已发布 或 有兜底标题」的笔记，避免图上出现无标题的空节点 */
const titleOf = (id) =>
  published.get(id)?.data.title ?? draftTitles[id] ?? '';

interface GNode {
  id: string;
  kind: 'course' | 'note';
  label: string;
  course: string;
  /** 课程节点才有 */
  count?: number;
  noteText?: string;
  /** 笔记节点才有 */
  href?: string;
  draft?: boolean;
  /** 章在课内的学习次序（1 起）；课程节点为 0 */
  rank: number;
  prereq: string[];
  x: number;
  y: number;
  row: number;
}

const nodes: GNode[] = [];
const edges: Array<{ s: string; t: string; cross: boolean }> = [];

/** 章 id → 课程 id，供跨课程依赖解析 */
const courseOfNote = new Map<string, string>();

for (const c of courses) {
  const usable = c.chapters.filter((ch) => titleOf(ch.id));
  if (!usable.length) continue;

  for (const ch of usable) {
    courseOfNote.set(ch.id, c.id);
    const dep = (ch.prereq ?? []).filter((p) => courseOfNote.has(p) || titleOf(p));
    const n: GNode = {
      id: ch.id,
      kind: 'note',
      label: shortTitle(titleOf(ch.id), c.id),
      course: c.id,
      href: published.has(ch.id) ? `/notes/${ch.id}/` : undefined,
      draft: !published.has(ch.id),
      rank: 0, // 下面按依赖深度重排后回填
      prereq: dep,
      x: 0,
      y: 0,
      row: 0,
    };
    nodes.push(n);
  }

  nodes.push({
    id: `course:${c.id}`,
    kind: 'course',
    label: c.id,
    course: c.id,
    count: usable.length,
    noteText: c.note ?? '',
    rank: 0,
    prereq: [],
    x: 0,
    y: 0,
    row: 0,
  });
}

const byId = new Map(nodes.map((n) => [n.id, n]));

/**
 * 课内排序：按**依赖深度**（最长前驱链）分层，同层内保持 curriculum.ts 里的书写顺序。
 * 这样纵向位置就天然保证「先修在上、后继在下」，而不用手写序号。
 */
for (const c of courses) {
  const ids = nodes.filter((n) => n.kind === 'note' && n.course === c.id).map((n) => n.id);
  if (!ids.length) continue;
  const inSet = new Set(ids);
  const depth = new Map<string, number>();
  const calc = (id, seen = new Set()) => {
    if (depth.has(id)) return depth.get(id);
    if (seen.has(id)) return 0; // 环保护：数据写错也不至于死循环
    seen.add(id);
    const n = byId.get(id);
    const ds = (n?.prereq ?? []).filter((p) => inSet.has(p)).map((p) => calc(p, seen) + 1);
    const d = ds.length ? Math.max(...ds) : 0;
    depth.set(id, d);
    return d;
  };
  for (const id of ids) calc(id);

  const order = new Map(ids.map((id, i) => [id, i]));
  [...ids]
    .sort((a, b) => depth.get(a) - depth.get(b) || order.get(a) - order.get(b))
    .forEach((id, i) => {
      const n = byId.get(id);
      if (n) n.rank = i + 1;
    });
}

/** 课程头 → 本课第一层（无课内先修的章）的边 */
for (const c of courses) {
  const hdr = `course:${c.id}`;
  if (!byId.has(hdr)) continue;
  const inCourse = nodes.filter((n) => n.kind === 'note' && n.course === c.id);
  const inIds = new Set(inCourse.map((n) => n.id));
  for (const n of inCourse) {
    const inside = n.prereq.filter((p) => inIds.has(p));
    if (!inside.length) edges.push({ s: hdr, t: n.id, cross: false });
    for (const p of inside) edges.push({ s: p, t: n.id, cross: false });
  }
}

/** 跨课程的先修边：源笔记在别的课里 → 连到那门课的课程节点（收起时也画得出来） */
for (const n of nodes) {
  if (n.kind !== 'note') continue;
  const inCourse = new Set(
    nodes.filter((x) => x.kind === 'note' && x.course === n.course).map((x) => x.id)
  );
  for (const p of n.prereq) {
    if (inCourse.has(p)) continue;
    const target = courseOfNote.has(p) ? `course:${courseOfNote.get(p)}` : null;
    if (target && byId.has(target)) edges.push({ s: target, t: n.id, cross: true });
  }
}

/** 课程之间的依赖 */
for (const [a, b] of courseDeps) {
  if (byId.has(`course:${a}`) && byId.has(`course:${b}`)) {
    edges.push({ s: `course:${b}`, t: `course:${a}`, cross: true });
  }
}

/** 画图只需要这几项，顺手减小内联 JSON 的体积 */
const payload = {
  nodes: nodes.map((n) => ({
    id: n.id,
    kind: n.kind,
    label: n.label,
    course: n.course,
    count: n.count,
    noteText: n.noteText,
    href: n.href,
    draft: n.draft,
    rank: n.rank,
  })),
  edges,
  courses: courses
    .filter((c) => byId.has(`course:${c.id}`))
    .map((c) => ({
      id: c.id,
      total: nodes.filter((n) => n.kind === 'note' && n.course === c.id).length,
      live: nodes.filter((n) => n.kind === 'note' && n.course === c.id && !n.draft).length,
    })),
};

const publishedCount = notes.length;
const totalChapters = payload.nodes.filter((n) => n.kind === 'note').length;
---

<BaseLayout
  title="知识图谱"
  description={`把 ${publishedCount} 篇已发布笔记按「先学 → 后学」的依赖连成一张有向图，点击课程可展开每一章。`}
>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a>
      <span>/</span>
      <a href="/notes/">笔记</a>
      <span>/</span>
      <span>知识图谱</span>
    </nav>

    <div class="page-head">
      <p class="page-head__kicker">Knowledge Graph</p>
      <h1>知识图谱</h1>
      <p class="page-head__lede">
        箭头方向是<strong>学习的先后顺序</strong>：指着谁，就表示「先学完它，再学这个」。
        点课程节点可以展开这门课的各章，再点收起；点某一章直接进那篇笔记。
        悬停或点击任一章，会把它<strong>整条先修链</strong>一起点亮。
      </p>
    </div>

    <div class="graph-layout graph-page">
      <aside class="graph-side">
        <div class="graph-side__group">
          <h2>课程</h2>
          <div class="graph-side__list" id="graph-courses"></div>
        </div>

        <div class="graph-side__group">
          <h2>操作</h2>
          <div class="graph-side__list">
            <button type="button" class="graph-btn" id="graph-expand-all">全部展开</button>
            <button type="button" class="graph-btn" id="graph-collapse-all">全部收起</button>
            <button type="button" class="graph-btn" id="graph-tidy">重新排列</button>
            <button type="button" class="graph-btn" id="graph-fit">适应窗口</button>
          </div>
          <p class="graph-side__hint" style="margin-top:0.75rem">
            虚线节点 = 该篇还是草稿、尚未发布；点它会提示，不会跳到空页面。
            <br />拖动节点可手动摆放，「重新排列」恢复整齐布局。
          </p>
        </div>
      </aside>

      <div class="graph-main">
        <div class="graph-bar">
          <input
            class="graph-search"
            id="graph-search"
            type="search"
            placeholder="搜索章节名，命中会高亮…"
            aria-label="搜索章节"
          />
          <span class="graph-legend">
            <span class="graph-legend__item">
              <svg width="26" height="10" aria-hidden="true">
                <line x1="1" y1="5" x2="19" y2="5" stroke="#d78b34" stroke-width="1.6" />
                <path d="M19 1.6 25 5l-6 3.4z" fill="#d78b34" />
              </svg>
              先学 → 后学
            </span>
          </span>
        </div>

        <div class="graph-stage">
          <svg
            class="graph-canvas"
            id="graph-canvas"
            role="img"
            aria-label={`${totalChapters} 章笔记按先修关系连成的有向图`}
          >
            <defs>
              <marker
                id="graph-arrow"
                viewBox="0 0 10 10"
                refX="9"
                refY="5"
                markerWidth="6"
                markerHeight="6"
                orient="auto-start-reverse"
              >
                <path d="M0 0 L10 5 L0 10 z" fill="#d9cbb9" />
              </marker>
              <marker
                id="graph-arrow-lit"
                viewBox="0 0 10 10"
                refX="9"
                refY="5"
                markerWidth="6"
                markerHeight="6"
                orient="auto-start-reverse"
              >
                <path d="M0 0 L10 5 L0 10 z" fill="#d78b34" />
              </marker>
            </defs>
            <g id="graph-viewport">
              <g id="graph-links"></g>
              <g id="graph-nodes"></g>
            </g>
          </svg>
          <div class="graph-tip" id="graph-tip" hidden></div>
        </div>

        <p class="graph-note">
          这张图反映的是<strong>教学上的先后依赖</strong>，不是正文里的互相引用——
          顺序来自 <code>src/data/curriculum.ts</code>，想调整先后只改那个文件。
        </p>
      </div>
    </div>
  </div>

  <script type="application/json" id="graph-data" set:html={JSON.stringify(payload)} />

  <script>
    /* ------------------------------------------------------------ 依赖图
       布局思路：课程成列、同课程内按依赖深度排纵向位置（手算网格），
       拖动或尺寸变化时再跑一小段「约束松弛」把重叠推开 —— 不引入任何物理引擎。 */
    (() => {
      const raw = document.getElementById('graph-data')?.textContent;
      if (!raw) return;
      const data = JSON.parse(raw);
      if (!data.nodes?.length) return;

      const svg = document.getElementById('graph-canvas');
      const viewport = document.getElementById('graph-viewport');
      const linkLayer = document.getElementById('graph-links');
      const nodeLayer = document.getElementById('graph-nodes');
      const tip = document.getElementById('graph-tip');
      const stage = svg.parentElement;
      const searchEl = document.getElementById('graph-search');
      const SVGNS = 'http://www.w3.org/2000/svg';

      const NODE_H = 30;
      const NODE_GAP = 14;
      const ROW_H = NODE_H + NODE_GAP;

      let W = 760;
      let H = 560;

      /* ---------------------------------------------------------- 状态 */
      const nodes = data.nodes.map((n) => ({
        ...n,
        x: 0,
        y: 0,
        /** 目标位置（网格算出来的），拖动过之后就不再跟随 */
        tx: 0,
        ty: 0,
        dragged: false,
      }));
      const byId = new Map(nodes.map((n) => [n.id, n]));
      const courseIds = data.courses.map((c) => c.id);

      /* ---------------------------------------------------------- 展开状态 */
      // 默认展开章最多的那门课，其余收起 —— 一次只看一门，图才稀疏。
      // ⚠️ 必须在建 `edges` 之前定好：边的起点要不要落到"课程节点"上取决于它。
      const biggest = [...data.courses].sort((a, b) => b.total - a.total)[0];
      const expanded = new Set(biggest ? [biggest.id] : []);

      const isVisible = (n) => n.kind === 'course' || expanded.has(n.course);
      const visibleNodes = () => nodes.filter(isVisible);

      /* ---------------------------------------------------------- 选中 / 搜索 */
      const lit = new Set();
      let current = null;
      let keyword = '';

      /**
       * 边在**构建期**是按「笔记 → 笔记」给的；收起的课程里那些源节点不在画面上，
       * 于是把起点上移到那门课的课程节点 —— 这样跨课程的先修关系依然看得见。
       */
      const edges = data.edges
        .map((e) => {
          const s = byId.get(e.s);
          const t = byId.get(e.t);
          if (!s || !t) return null;
          const src =
            s.kind === 'note' && s.course !== t.course && !expanded.has(s.course)
              ? byId.get(`course:${s.course}`)
              : s;
          return { s: src, t, cross: !!e.cross };
        })
        .filter((e) => e && e.s && e.t && e.s !== e.t);

      const prereqOf = new Map();
      const nextOf = new Map();
      for (const e of edges) {
        if (!prereqOf.has(e.t.id)) prereqOf.set(e.t.id, []);
        prereqOf.get(e.t.id).push(e.s.id);
        if (!nextOf.has(e.s.id)) nextOf.set(e.s.id, []);
        nextOf.get(e.s.id).push(e.t.id);
      }

      /* ---------------------------------------------------------- 手算布局 */
      /**
       * 网格：
       *   · 每门课一列，列宽按可见节点数分配（展开的课分得宽）；
       *   · 列内：课程头在最上，各章按 rank 自上而下；
       *   · 未展开的课只占一个课程节点。
       * 目标位置写进 n.tx / n.ty，实际位置 n.x / n.y 由松弛过程去逼近。
       */
      function computeLayout() {
        const vis = visibleNodes();
        const cols = courseIds
          .map((cid) => {
            const list = vis.filter((n) => n.course === cid);
            return { cid, list, weight: expanded.has(cid) ? Math.max(1, list.length) : 0.8 };
          })
          .filter((c) => c.list.length);

        // 列宽与列中心：展开的课宽一些
        const totalW = Math.max(1, cols.reduce((s, c) => s + c.weight, 0));
        let acc = 0;
        for (const c of cols) {
          const share = c.weight / totalW;
          c.cx = (acc + share / 2) * W;
          acc += share;
          for (const n of c.list) {
            n.col = c.cx;
            // 同课程内按 rank 排纵向位置；课程头固定在最上
            const rank = n.kind === 'course' ? 0 : n.rank;
            n.row = rank;
          }
        }

        // 纵向：所有课程头对齐在顶部，其下各章按 rank 顺排
        const top = 54;
        for (const n of vis) {
          n.tx = n.col;
          n.ty = top + n.row * ROW_H;
        }
      }

      /** 目标位置：默认取网格；被拖动过的节点用自己拖到的位置 */
      function targetOf(n) {
        return n.dragged ? { x: n.x, y: n.y } : { x: n.tx, y: n.ty };
      }

      /**
       * 约束松弛：
       *   1) 每个节点被自己的目标位置"拴住"（弹簧）
       *   2) 有向边把两端拉近一点（别离太远）
       *   3) 任何两个节点靠得太近就沿连心线推开（解决重叠，尤其是逐字变长时）
       * 只跑几次，够用且稳定，不会把网格搅乱。
       */
      function relax(iterations = 260) {
        const vis = visibleNodes();
        const minDx = 140;
        const minDy = ROW_H - 4;
        for (let it = 0; it < iterations; it++) {
          const k = 1 - it / iterations; // 逐轮减弱，末段基本静止
          // 拴住目标位置
          for (const n of vis) {
            const t = targetOf(n);
            n.x += (t.x - n.x) * 0.22 * k;
            n.y += (t.y - n.y) * 0.22 * k;
          }
          // 边拉近
          for (const e of edges) {
            if (!isVisible(e.s) || !isVisible(e.t)) continue;
            const dx = e.t.x - e.s.x;
            const dy = e.t.y - e.s.y;
            const d = Math.max(1, Math.hypot(dx, dy));
            const want = 96;
            const f = ((d - want) / d) * 0.06 * k;
            e.s.x += dx * f;
            e.s.y += dy * f;
            e.t.x -= dx * f;
            e.t.y -= dy * f;
          }
          // 推开重叠
          for (let i = 0; i < vis.length; i++) {
            for (let j = i + 1; j < vis.length; j++) {
              const a = vis[i];
              const b = vis[j];
              let dx = b.x - a.x;
              let dy = b.y - a.y;
              if (Math.abs(dx) >= minDx || Math.abs(dy) >= minDy) continue;
              const ox = (minDx - Math.abs(dx)) / 2;
              const oy = (minDy - Math.abs(dy)) / 2;
              const sx = dx === 0 ? 1 : Math.sign(dx);
              const sy = dy === 0 ? 1 : Math.sign(dy);
              a.x -= ox * sx * 0.5;
              b.x += ox * sx * 0.5;
              a.y -= oy * sy * 0.5;
              b.y += oy * sy * 0.5;
            }
          }
        }
      }

      function seedFromGrid() {
        computeLayout();
        for (const n of visibleNodes()) {
          if (n.dragged) continue;
          n.x = n.tx;
          n.y = n.ty;
        }
        relax();
      }

      /* ---------------------------------------------------------- 渲染 */
      function rebuildLit() {
        lit.clear();
        if (!current) return;
        lit.add(current);
        const up = [current];
        while (up.length) {
          const id = up.pop();
          for (const p of prereqOf.get(id) ?? []) {
            if (!lit.has(p) && byId.has(p)) {
              lit.add(p);
              up.push(p);
            }
          }
        }
        const down = [current];
        while (down.length) {
          const id = down.pop();
          for (const nx of nextOf.get(id) ?? []) {
            if (!lit.has(nx) && byId.has(nx)) {
              lit.add(nx);
              down.push(nx);
            }
          }
        }
      }

      function render() {
        const vis = visibleNodes();
        const seen = new Set(vis.map((n) => n.id));

        linkLayer.replaceChildren();
        nodeLayer.replaceChildren();

        for (const e of edges) {
          if (!seen.has(e.s.id) || !seen.has(e.t.id)) continue;
          const isLit = current && lit.has(e.s.id) && lit.has(e.t.id);
          const path = document.createElementNS(SVGNS, 'path');
          // 轻微弧线：同列里上下相邻的两点用直线，跨列时弯一点才看得出方向
          const dx = e.t.x - e.s.x;
          const dy = e.t.y - e.s.y;
          const bend = Math.abs(dx) < 6 ? 0 : Math.min(38, Math.abs(dx) * 0.18);
          const mx = (e.s.x + e.t.x) / 2 + (bend ? Math.sign(dx) * bend : 0);
          const my = (e.s.y + e.t.y) / 2;
          const x1 = e.s.x;
          const y1 = e.s.y + (e.s.kind === 'course' ? 15 : 15);
          const x2 = e.t.x;
          const y2 = e.t.y - 15;
          path.setAttribute('d', `M${x1},${y1} Q${mx},${my} ${x2},${y2}`);
          path.setAttribute('fill', 'none');
          path.setAttribute(
            'class',
            'graph-link' + (isLit ? ' is-lit' : current ? ' is-dim' : '')
          );
          path.setAttribute('marker-end', isLit ? 'url(#graph-arrow-lit)' : 'url(#graph-arrow)');
          linkLayer.appendChild(path);
        }

        for (const n of vis) {
          const g = document.createElementNS(SVGNS, 'g');
          const cls = ['graph-node'];
          if (n.kind === 'course') cls.push('graph-node--course');
          if (n.draft) cls.push('graph-node--draft');
          if (current === n.id) cls.push('is-current');
          if (current && !lit.has(n.id)) cls.push('is-dim');
          const kw = keyword;
          if (kw && n.label.toLowerCase().includes(kw)) cls.push('is-hit');
          g.setAttribute('class', cls.join(' '));
          g.setAttribute('transform', `translate(${n.x},${n.y})`);
          g.dataset.id = n.id;

          const rect = document.createElementNS(SVGNS, 'rect');
          const w = nodeWidth(n);
          rect.setAttribute('x', String(-w / 2));
          rect.setAttribute('y', String(-NODE_H / 2));
          rect.setAttribute('width', String(w));
          rect.setAttribute('height', String(NODE_H));
          rect.setAttribute('rx', '8');
          g.appendChild(rect);

          const text = document.createElementNS(SVGNS, 'text');
          text.setAttribute('text-anchor', 'middle');
          text.setAttribute('y', '4');
          text.textContent = n.label;
          g.appendChild(text);

          if (n.kind === 'course') {
            const badge = document.createElementNS(SVGNS, 'text');
            badge.setAttribute('class', 'graph-node__badge');
            badge.setAttribute('text-anchor', 'middle');
            badge.setAttribute('y', String(-NODE_H / 2 - 8));
            badge.textContent = expanded.has(n.course)
              ? `${n.count} 章（点击收起）`
              : `${n.count} 章（点击展开）`;
            g.appendChild(badge);
          }
          nodeLayer.appendChild(g);
        }
      }

      /** 节点宽度按字数估：中文约 13px/字 */
      function nodeWidth(n) {
        const base = n.kind === 'course' ? 150 : 0;
        const w = Math.max(base, n.label.length * 13.5 + 26);
        return Math.min(w, n.kind === 'course' ? 220 : 190);
      }

      /* ---------------------------------------------------------- 视图变换 */
      let scale = 1;
      let tx = 0;
      let ty = 0;
      const applyView = () => {
        viewport.setAttribute('transform', `translate(${tx},${ty}) scale(${scale})`);
      };

      function fit(padding = 48) {
        const vis = visibleNodes();
        if (!vis.length) return;
        let minX = Infinity;
        let minY = Infinity;
        let maxX = -Infinity;
        let maxY = -Infinity;
        for (const n of vis) {
          const hw = nodeWidth(n) / 2;
          minX = Math.min(minX, n.x - hw);
          maxX = Math.max(maxX, n.x + hw);
          minY = Math.min(minY, n.y - NODE_H / 2 - 14);
          maxY = Math.max(maxY, n.y + NODE_H / 2 + 4);
        }
        const w = Math.max(1, maxX - minX);
        const h = Math.max(1, maxY - minY);
        scale = Math.min((W - padding * 2) / w, (H - padding * 2) / h, 1.5);
        tx = (W - w * scale) / 2 - minX * scale;
        ty = (H - h * scale) / 2 - minY * scale;
        applyView();
      }

      const toLocal = (evt) => {
        const r = svg.getBoundingClientRect();
        return { x: ((evt.clientX - r.left) / r.width) * W, y: ((evt.clientY - r.top) / r.height) * H };
      };
      const toGraph = (p) => ({ x: (p.x - tx) / scale, y: (p.y - ty) / scale });

      /* ---------------------------------------------------------- 交互 */
      let dragging = null;
      let panning = null;

      svg.addEventListener('pointerdown', (evt) => {
        const g = evt.target.closest?.('.graph-node');
        if (g && byId.has(g.dataset.id)) {
          const n = byId.get(g.dataset.id);
          dragging = { node: n, moved: 0 };
          svg.setPointerCapture(evt.pointerId);
          svg.classList.add('is-dragging');
          return;
        }
        panning = { ...toLocal(evt), tx, ty };
        svg.setPointerCapture(evt.pointerId);
        svg.classList.add('is-panning');
      });

      svg.addEventListener('pointermove', (evt) => {
        if (dragging) {
          const p = toGraph(toLocal(evt));
          const n = dragging.node;
          dragging.moved += Math.hypot(p.x - n.x, p.y - n.y);
          n.x = p.x;
          n.y = p.y;
          n.dragged = true;
          relax(40);
          render();
          return;
        }
        if (panning) {
          const p = toLocal(evt);
          tx = panning.tx + (p.x - panning.x);
          ty = panning.ty + (p.y - panning.y);
          applyView();
          return;
        }
        const g = evt.target.closest?.('.graph-node');
        if (g && byId.has(g.dataset.id)) showTip(byId.get(g.dataset.id), toLocal(evt));
        else hideTip();
      });

      function endPointer(evt) {
        if (dragging) {
          const g = evt.target.closest?.('.graph-node');
          if (dragging.moved < 4 && g?.dataset.id === dragging.node.id) {
            activate(dragging.node);
          }
          dragging = null;
          svg.classList.remove('is-dragging');
        }
        if (panning) {
          panning = null;
          svg.classList.remove('is-panning');
        }
        if (svg.hasPointerCapture?.(evt.pointerId)) svg.releasePointerCapture(evt.pointerId);
      }
      svg.addEventListener('pointerup', endPointer);
      svg.addEventListener('pointercancel', endPointer);
      svg.addEventListener('pointerleave', hideTip);

      /** 单击节点：课程 → 展开/收起；章节 → 选中这条链；有链接的连点两次才跳 */
      function activate(n) {
        if (n.kind === 'course') {
          if (expanded.has(n.course)) expanded.delete(n.course);
          else expanded.add(n.course);
          // 收起某课时，把它下面被拖过的节点也复位，免得再展开时位置很怪
          for (const x of nodes) if (x.course === n.course) x.dragged = false;
          current = null;
          rebuildLit();
          syncSidebar();
          seedFromGrid();
          render();
          fit();
          return;
        }
        if (current === n.id) {
          if (n.href) window.location.href = n.href;
          else flashTip(n, '这篇还是草稿，尚未发布');
          return;
        }
        current = n.id;
        rebuildLit();
        render();
        if (!n.href) flashTip(n, '这篇还是草稿，尚未发布');
      }

      let flashTimer = 0;
      function flashTip(n, extra) {
        clearTimeout(flashTimer);
        showTip(n, null, extra);
        flashTimer = window.setTimeout(() => {
          if (!dragging) hideTip();
        }, 2200);
      }

      svg.addEventListener(
        'wheel',
        (evt) => {
          evt.preventDefault();
          const p = toLocal(evt);
          const before = toGraph(p);
          scale = Math.min(3, Math.max(0.35, scale * (evt.deltaY < 0 ? 1.12 : 0.89)));
          const after = toGraph(p);
          tx += (after.x - before.x) * scale;
          ty += (after.y - before.y) * scale;
          applyView();
        },
        { passive: false }
      );

      /* ---------------------------------------------------------- 信息卡 */
      function showTip(n, at, extra) {
        const p = n.kind === 'course' ? { x: n.x, y: n.y } : { x: n.x, y: n.y };
        const screen = { x: p.x * scale + tx, y: p.y * scale + ty };
        const box = stage.getBoundingClientRect();
        tip.innerHTML = '';

        const t = document.createElement('p');
        t.className = 'graph-tip__title';
        t.textContent = n.kind === 'course' ? n.label : n.label;
        const m = document.createElement('p');
        m.className = 'graph-tip__meta';
        m.textContent =
          n.kind === 'course'
            ? `${n.course} · 共 ${n.count} 章`
            : `${n.course} · 第 ${n.rank} 章${n.draft ? ' · 草稿未发布' : ''}`;
        tip.append(t, m);

        const d = document.createElement('p');
        d.className = 'graph-tip__desc';
        if (extra) d.textContent = extra;
        else if (n.kind === 'course') d.textContent = n.noteText || '点击展开这门课的各章';
        else {
          const pre = (prereqOf.get(n.id) ?? [])
            .map((id) => byId.get(id)?.label)
            .filter(Boolean);
          d.textContent = pre.length ? `先修：${pre.join('、')}` : '入门章节，没有先修要求';
        }
        tip.appendChild(d);

        tip.hidden = false;
        const ax = at ? at.x : screen.x;
        const ay = at ? at.y : screen.y;
        const x = Math.min(ax + 14, box.width - tip.offsetWidth - 8);
        const y = Math.min(ay + 18, box.height - tip.offsetHeight - 8);
        tip.style.left = `${Math.max(8, x)}px`;
        tip.style.top = `${Math.max(8, y)}px`;
      }
      function hideTip() {
        tip.hidden = true;
      }

      /* ---------------------------------------------------------- 侧栏 */
      function syncSidebar() {
        const host = document.getElementById('graph-courses');
        if (!host) return;
        host.replaceChildren();
        for (const c of data.courses) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'graph-side__item' + (expanded.has(c.id) ? ' is-active' : '');
          btn.dataset.course = c.id;
          const dot = document.createElement('span');
          dot.className = 'graph-side__dot';
          dot.style.background = courseColor(c.id);
          const name = document.createElement('span');
          name.textContent = c.id;
          const count = document.createElement('span');
          count.className = 'graph-side__count';
          count.textContent = `${c.total}`;
          btn.append(dot, name, count);
          host.appendChild(btn);
        }
      }

      function courseColor(id) {
        const palette = ['#d78b34', '#4f9a76', '#c9402e', '#7a6bb5', '#3f8fb0', '#c2486f'];
        const i = courseIds.indexOf(id);
        return palette[(i < 0 ? 0 : i) % palette.length];
      }

      document.getElementById('graph-courses')?.addEventListener('click', (evt) => {
        const btn = evt.target.closest?.('[data-course]');
        if (!btn) return;
        const id = btn.dataset.course;
        if (expanded.has(id)) expanded.delete(id);
        else expanded.add(id);
        for (const x of nodes) if (x.course === id) x.dragged = false;
        current = null;
        rebuildLit();
        syncSidebar();
        seedFromGrid();
        render();
        fit();
      });

      document.getElementById('graph-expand-all')?.addEventListener('click', () => {
        for (const c of data.courses) expanded.add(c.id);
        current = null;
        rebuildLit();
        syncSidebar();
        seedFromGrid();
        render();
        fit();
      });

      document.getElementById('graph-collapse-all')?.addEventListener('click', () => {
        expanded.clear();
        for (const x of nodes) x.dragged = false;
        current = null;
        rebuildLit();
        syncSidebar();
        seedFromGrid();
        render();
        fit();
      });

      document.getElementById('graph-tidy')?.addEventListener('click', () => {
        for (const x of nodes) x.dragged = false;
        seedFromGrid();
        render();
        fit();
      });

      document.getElementById('graph-fit')?.addEventListener('click', () => fit());

      let searchTimer = 0;
      searchEl?.addEventListener('input', () => {
        clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => {
          keyword = searchEl.value.trim().toLowerCase();
          render();
        }, 120);
      });

      /* ---------------------------------------------------------- 尺寸 */
      function resize() {
        const r = svg.getBoundingClientRect();
        W = Math.max(320, r.width);
        H = Math.max(300, r.height);
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        fit();
      }

      /* ---------------------------------------------------------- 启动 */
      resize();
      seedFromGrid();
      syncSidebar();
      render();
      fit();

      let rt = 0;
      window.addEventListener('resize', () => {
        clearTimeout(rt);
        rt = window.setTimeout(() => {
          resize();
          seedFromGrid();
          render();
          fit();
        }, 150);
      });
    })();
  </script>
</BaseLayout>

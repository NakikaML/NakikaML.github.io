---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contentNotes, noteSummary } from '../../utils/notes';

/**
 * 知识图谱 /notes/graph/
 * ============================================================
 * Obsidian 那种「点上鼠标能拖、滚轮能缩」的关系图。**零第三方依赖**——
 * 力导引仿真（斥力 + 弹簧 + 向心力）与渲染都是这个文件里手写的，
 * 原因见 bug及意见汇总.md：mermaid 那次的教训是「上游的运行时懒加载会在
 * 打包产物里静默失效」，能自己控住的就不外包。
 *
 * 数据在**构建期**算好，内联成一段 JSON 交给客户端：
 *   · 节点 = 一篇已发布笔记（草稿不进图谱，与列表页口径一致）
 *   · 边   = 同 subfield（同课程，权重 2）或共享标签（权重 1）
 * 笔记之间目前没有显式互链（opinion-10 把「相关笔记」摘掉了），
 * 所以关系只能从这两处 frontmatter 字段推——这也是当初保留它们的理由。
 */

const notes = await contentNotes();
const courses = [...new Set(notes.map((n) => n.data.subfield).filter(Boolean))].sort();

/** 课程配色：在暖色调里挑 6 个能彼此分辨、又和全站配色不打架的颜色 */
const COURSE_COLORS = ['#d78b34', '#4f9a76', '#c9402e', '#7a6bb5', '#3f8fb0', '#c2486f'];
const colorOf = (subfield) => {
  const i = courses.indexOf(subfield);
  return COURSE_COLORS[(i < 0 ? 0 : i) % COURSE_COLORS.length];
};

const nodes = notes.map((n) => ({
  id: n.id,
  title: n.data.title,
  desc: noteSummary(n, 80),
  cat: n.data.category,
  sub: n.data.subfield || '未分组',
  diff: n.data.difficulty || '',
  tags: n.data.tags ?? [],
  date: n.data.date || '',
  href: `/notes/${n.id}/`,
  r: 6 + Math.min(6, (n.data.tags ?? []).length),
  color: colorOf(n.data.subfield || '未分组'),
}));

/** 边：同课程 2 分，每共享一个标签 1 分 */
const edges = [];
for (let i = 0; i < nodes.length; i++) {
  for (let j = i + 1; j < nodes.length; j++) {
    const a = nodes[i];
    const b = nodes[j];
    const sameCourse = a.sub === b.sub;
    const shared = a.tags.filter((t) => b.tags.includes(t));
    if (!sameCourse && shared.length === 0) continue;
    const w = (sameCourse ? 2 : 0) + shared.length;
    edges.push({ s: a.id, t: b.id, w, shared: shared.slice(0, 4) });
  }
}

const payload = { nodes, edges, courses };

const tagCovered = new Set(edges.flatMap((e) => e.shared));
const isolated = nodes.filter(
  (n) => !edges.some((e) => e.s === n.id || e.t === n.id)
).length;
---

<BaseLayout
  title="知识图谱"
  description={`把 ${nodes.length} 篇笔记按课程与标签连成一张可拖拽缩放的关系图，点节点即可进入笔记。`}
>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a>
      <span>/</span>
      <a href="/notes/">笔记</a>
      <span>/</span>
      <span>知识图谱</span>
    </nav>

    <div class="page-head">
      <p class="page-head__kicker">Knowledge Graph</p>
      <h1>知识图谱</h1>
      <p class="page-head__lede">
        {nodes.length} 篇笔记连成的一张网：<strong>同课程的笔记聚成一团</strong>，
        <strong>共享标签的笔记跨课程相连</strong>。拖动能挪节点，滚轮能缩放，
        单击跳到那篇笔记，双击把它和邻居固定住。
      </p>
    </div>

    {
      nodes.length === 0 ? (
        <div class="empty" style="text-align:left;padding:2rem">
          <p style="margin:0;color:var(--text-muted)">
            还没有已发布的笔记，所以图谱是空的。
          </p>
        </div>
      ) : (
        <div class="graph-layout graph-page">
          <aside class="graph-side">
            <div class="graph-side__group">
              <h2>课程</h2>
              <div class="graph-side__list" id="graph-courses">
                <button type="button" class="graph-side__item is-active" data-course="">
                  全部
                  <span class="graph-side__count">{nodes.length}</span>
                </button>
                {courses.map((c) => (
                  <button type="button" class="graph-side__item" data-course={c}>
                    <span class="graph-side__dot" style={`background:${colorOf(c)}`} />
                    {c}
                    <span class="graph-side__count">
                      {nodes.filter((n) => n.sub === c).length}
                    </span>
                  </button>
                ))}
              </div>
            </div>

            <div class="graph-side__group">
              <h2>操作</h2>
              <div class="graph-side__list">
                <button type="button" class="graph-btn" id="graph-relayout">重新布局</button>
                <button type="button" class="graph-btn" id="graph-fit">适应窗口</button>
              </div>
              <p class="graph-side__hint" style="margin-top:0.75rem">
                节点越大 = 标签越多；虚线描边 = 难度标为「困难」。
              </p>
            </div>
          </aside>

          <div class="graph-main">
            <div class="graph-bar">
              <input
                class="graph-search"
                id="graph-search"
                type="search"
                placeholder="搜索标题或标签，命中会高亮…"
                aria-label="搜索笔记"
              />
              <button type="button" class="graph-btn is-on" id="graph-labels" aria-pressed="true">
                标签
              </button>
            </div>

            <div class="graph-stage">
              <svg
                class="graph-canvas"
                id="graph-canvas"
                role="img"
                aria-label={`${nodes.length} 篇笔记的关系图`}
              >
                <g id="graph-viewport">
                  <g id="graph-links"></g>
                  <g id="graph-nodes"></g>
                </g>
              </svg>
              <div class="graph-tip" id="graph-tip" hidden></div>
            </div>

            <p class="graph-note">
              关系来自 frontmatter 的 <code>subfield</code>（课程）与 <code>tags</code>（标签）——
              {edges.length} 条连线
              {isolated > 0 &&
                `，其中 ${isolated} 篇暂时没有和其他笔记连上（标签还比较独立）`}
              。笔记之间暂时不做正文互链，所以这张网反映的是「同源」而不是「互相引用」。
            </p>
          </div>
        </div>
      )
    }
  </div>

  <script type="application/json" id="graph-data" set:html={JSON.stringify(payload)} />

  <script>
    /* ------------------------------------------------------------ 力导引图谱
       一次性小脚本：读上面的 JSON，做仿真，画到 SVG。没有依赖，没有构建期魔法。 */
    (() => {
      const raw = document.getElementById('graph-data')?.textContent;
      if (!raw) return;
      const data = JSON.parse(raw);
      if (!data.nodes?.length) return;

      const svg = document.getElementById('graph-canvas');
      const viewport = document.getElementById('graph-viewport');
      const linkLayer = document.getElementById('graph-links');
      const nodeLayer = document.getElementById('graph-nodes');
      const tip = document.getElementById('graph-tip');
      const stage = svg.parentElement;
      const searchEl = document.getElementById('graph-search');
      const labelsBtn = document.getElementById('graph-labels');
      const SVGNS = 'http://www.w3.org/2000/svg';

      /* 与 CSS 里的 var(--accent) 一致；SVG 属性拿不到 CSS 变量，只能写死 */
      const ACCENT = '#d78b34';
      const MUTED = '#9a8d7d';

      let W = 760;
      let H = 560;

      /* ---------------------------------------------------------- 状态 */
      const nodes = data.nodes.map((n) => ({
        ...n,
        x: 0,
        y: 0,
        vx: 0,
        vy: 0,
        fixed: false,
      }));
      const byId = new Map(nodes.map((n) => [n.id, n]));
      const links = data.edges.map((e) => ({
        ...e,
        a: byId.get(e.s),
        b: byId.get(e.t),
      }));

      let course = '';
      let keyword = '';
      let showLabels = true;
      let current = null;
      let hovered = null;

      /* ---------------------------------------------------------- 仿真参数 */
      const REPULSION = 5200; // 节点之间斥力强度
      const SPRING = 0.012; // 弹簧系数
      const CENTER_PULL = 0.006; // 向心力（防止整张图飘走）
      const DAMPING = 0.82; // 速度阻尼
      const MAX_STEPS = 420; // 收敛上限
      let alpha = 1;

      /** 边的理想长度：同课程更短，靠得紧的标签也更短 */
      const restOf = (l) => 62 + 34 / l.w;

      function seed() {
        // 用黄金角螺旋铺初始位置：比纯随机收敛快，也不会出现对称死锁
        const golden = Math.PI * (3 - Math.sqrt(5));
        nodes.forEach((n, i) => {
          const r = 40 + 15 * Math.sqrt(i);
          const a = golden * i;
          n.x = Math.cos(a) * r;
          n.y = Math.sin(a) * r;
          n.vx = 0;
          n.vy = 0;
          n.fixed = false;
        });
        alpha = 1;
      }

      /** 走一步仿真。steps 越大越接近静态解 */
      function tick(steps = 1) {
        for (let s = 0; s < steps; s++) {
          // 斥力：遍历所有节点对（22 个节点 = 231 对，够用）
          for (let i = 0; i < nodes.length; i++) {
            const a = nodes[i];
            for (let j = i + 1; j < nodes.length; j++) {
              const b = nodes[j];
              let dx = b.x - a.x;
              let dy = b.y - a.y;
              let d2 = dx * dx + dy * dy;
              if (d2 < 1) {
                // 完全重合就轻轻推开，否则会 NaN
                dx = (Math.random() - 0.5) * 2;
                dy = (Math.random() - 0.5) * 2;
                d2 = 1;
              }
              const d = Math.sqrt(d2);
              const f = (REPULSION * alpha) / d2;
              const fx = (dx / d) * f;
              const fy = (dy / d) * f;
              a.vx -= fx;
              a.vy -= fy;
              b.vx += fx;
              b.vy += fy;
            }
          }

          // 弹簧：把它两端的节点拉近到 restOf 给的长度
          for (const l of links) {
            const dx = l.b.x - l.a.x;
            const dy = l.b.y - l.a.y;
            const d = Math.max(1, Math.hypot(dx, dy));
            const f = (d - restOf(l)) * SPRING * l.w * alpha;
            const fx = (dx / d) * f;
            const fy = (dy / d) * f;
            l.a.vx += fx;
            l.a.vy += fy;
            l.b.vx -= fx;
            l.b.vy -= fy;
          }

          // 向心力 + 积分
          for (const n of nodes) {
            n.vx -= n.x * CENTER_PULL * alpha;
            n.vy -= n.y * CENTER_PULL * alpha;
            n.vx *= DAMPING;
            n.vy *= DAMPING;
            if (!n.fixed) {
              n.x += n.vx;
              n.y += n.vy;
            }
          }
          alpha *= 0.992;
        }
      }

      /* ---------------------------------------------------------- 渲染 */
      function visibleSet() {
        // 课程筛选：只显示该课程的节点与两端都在集合内的边
        if (!course) return null;
        return new Set(nodes.filter((n) => n.sub === course).map((n) => n.id));
      }

      function render() {
        const vis = visibleSet();
        const shown = vis ? nodes.filter((n) => vis.has(n.id)) : nodes;

        linkLayer.replaceChildren();
        nodeLayer.replaceChildren();

        const lit = new Set();
        if (current) {
          lit.add(current);
          for (const l of links) {
            if (l.s === current) lit.add(l.t);
            if (l.t === current) lit.add(l.s);
          }
        }

        for (const l of links) {
          if (vis && !(vis.has(l.s) && vis.has(l.t))) continue;
          const isLit = lit.has(l.s) && lit.has(l.t);
          const line = document.createElementNS(SVGNS, 'line');
          line.setAttribute('x1', l.a.x);
          line.setAttribute('y1', l.a.y);
          line.setAttribute('x2', l.b.x);
          line.setAttribute('y2', l.b.y);
          line.setAttribute('stroke-width', String(0.7 + l.w * 0.5));
          line.setAttribute(
            'class',
            'graph-link' + (isLit ? ' is-lit' : current ? ' is-dim' : '')
          );
          linkLayer.appendChild(line);
        }

        for (const n of shown) {
          const g = document.createElementNS(SVGNS, 'g');
          const cls = ['graph-node'];
          if (n.diff === '困难') cls.push('graph-node--hard');
          if (current === n.id) cls.push('is-current');
          if (current && !lit.has(n.id)) cls.push('is-dim');
          const hit =
            keyword &&
            (n.title.toLowerCase().includes(keyword) ||
              n.tags.some((t) => t.toLowerCase().includes(keyword)));
          if (hit) cls.push('is-hit');
          g.setAttribute('class', cls.join(' '));
          g.setAttribute('transform', `translate(${n.x},${n.y})`);
          g.dataset.id = n.id;

          const c = document.createElementNS(SVGNS, 'circle');
          c.setAttribute('r', String(n.r));
          c.setAttribute('stroke', n.color);
          g.appendChild(c);

          const label = document.createElementNS(SVGNS, 'text');
          label.setAttribute('text-anchor', 'middle');
          label.setAttribute('y', String(n.r + 12));
          // 标签太长会把画面糊掉，截断但保留可读前缀
          label.textContent = showLabels
            ? n.title.length > 14
              ? n.title.slice(0, 13) + '…'
              : n.title
            : '';
          g.appendChild(label);

          nodeLayer.appendChild(g);
        }
      }

      /* ---------------------------------------------------------- 视图变换 */
      let scale = 1;
      let tx = 0;
      let ty = 0;

      function applyView() {
        viewport.setAttribute('transform', `translate(${tx},${ty}) scale(${scale})`);
      }

      /** 计算包围盒并缩放平移到刚好铺满 */
      function fit(padding = 46) {
        const vis = visibleSet();
        const shown = vis ? nodes.filter((n) => vis.has(n.id)) : nodes;
        if (!shown.length) return;
        let minX = Infinity;
        let minY = Infinity;
        let maxX = -Infinity;
        let maxY = -Infinity;
        for (const n of shown) {
          minX = Math.min(minX, n.x - n.r);
          minY = Math.min(minY, n.y - n.r - 14);
          maxX = Math.max(maxX, n.x + n.r);
          maxY = Math.max(maxY, n.y + n.r + 14);
        }
        const w = Math.max(1, maxX - minX);
        const h = Math.max(1, maxY - minY);
        scale = Math.min((W - padding * 2) / w, (H - padding * 2) / h, 1.6);
        // 标签会往下伸一点，视觉中心略微上移更平衡
        tx = (W - w * scale) / 2 - minX * scale;
        ty = (H - h * scale) / 2 - minY * scale;
        applyView();
      }

      const toLocal = (evt) => {
        const r = svg.getBoundingClientRect();
        return {
          x: ((evt.clientX - r.left) / r.width) * W,
          y: ((evt.clientY - r.top) / r.height) * H,
        };
      };
      const toGraph = (pt) => ({ x: (pt.x - tx) / scale, y: (pt.y - ty) / scale });

      /* ---------------------------------------------------------- 交互 */
      let dragging = null;
      let panning = null;

      svg.addEventListener('pointerdown', (evt) => {
        const g = evt.target.closest?.('.graph-node');
        if (g && byId.has(g.dataset.id)) {
          const n = byId.get(g.dataset.id);
          n.fixed = true;
          // 给仿真重新"加一点温"：拖动时相连的邻居会跟着让位，
          // 而不是像钉在木板上一样纹丝不动。alpha 很小，不会把整张图搅乱。
          alpha = Math.max(alpha, 0.35);
          dragging = { node: n, moved: 0 };
          svg.setPointerCapture(evt.pointerId);
          svg.classList.add('is-dragging');
          return;
        }
        panning = { ...toLocal(evt), tx, ty };
        svg.setPointerCapture(evt.pointerId);
        svg.classList.add('is-panning');
      });

      svg.addEventListener('pointermove', (evt) => {
        if (dragging) {
          const p = toGraph(toLocal(evt));
          const n = dragging.node;
          dragging.moved += Math.hypot(p.x - n.x, p.y - n.y);
          n.x = p.x;
          n.y = p.y;
          n.vx = 0;
          n.vy = 0;
          // 只跑几步：邻居轻轻让位就够，跑满会拖慢拖拽手感
          tick(3);
          render();
          return;
        }
        if (panning) {
          const p = toLocal(evt);
          tx = panning.tx + (p.x - panning.x);
          ty = panning.ty + (p.y - panning.y);
          applyView();
          return;
        }
        // 悬停：只更新信息卡，不动整张图（22 个节点全量重画也不贵，但没必要）
        const g = evt.target.closest?.('.graph-node');
        const id = g?.dataset.id;
        if (id) {
          hovered = id;
          showTip(byId.get(id), toLocal(evt));
        } else if (hovered) {
          hovered = null;
          hideTip();
        }
      });

      function endPointer(evt) {
        if (dragging) {
          const g = evt.target.closest?.('.graph-node');
          // 位移很小视为「单击」→ 进入笔记；拖过就不跳，免得想挪一下却被弹走
          if (dragging.moved < 4 && g?.dataset.id === dragging.node.id) {
            window.location.href = dragging.node.href;
          }
          dragging = null;
          svg.classList.remove('is-dragging');
        }
        if (panning) {
          panning = null;
          svg.classList.remove('is-panning');
        }
        if (svg.hasPointerCapture?.(evt.pointerId)) svg.releasePointerCapture(evt.pointerId);
      }
      svg.addEventListener('pointerup', endPointer);
      svg.addEventListener('pointercancel', endPointer);

      // 双击：把节点钉住 / 松开
      svg.addEventListener('dblclick', (evt) => {
        const g = evt.target.closest?.('.graph-node');
        if (!g || !byId.has(g.dataset.id)) return;
        const n = byId.get(g.dataset.id);
        n.fixed = !n.fixed;
        if (!n.fixed) {
          n.vx = 0;
          n.vy = 0;
        }
      });

      // 滚轮缩放（以指针位置为锚点，手感才对）
      svg.addEventListener(
        'wheel',
        (evt) => {
          evt.preventDefault();
          const p = toLocal(evt);
          const before = toGraph(p);
          scale = Math.min(3.2, Math.max(0.35, scale * (evt.deltaY < 0 ? 1.12 : 0.89)));
          const after = toGraph(p);
          tx += (after.x - before.x) * scale;
          ty += (after.y - before.y) * scale;
          applyView();
        },
        { passive: false }
      );

      /* ---------------------------------------------------------- 信息卡 */
      function showTip(n, at) {
        if (!n) return;
        tip.innerHTML = '';
        const t = document.createElement('p');
        t.className = 'graph-tip__title';
        t.textContent = n.title;
        const m = document.createElement('p');
        m.className = 'graph-tip__meta';
        m.textContent = [n.sub, n.diff, n.date].filter(Boolean).join(' · ');
        const d = document.createElement('p');
        d.className = 'graph-tip__desc';
        d.textContent = n.desc;
        tip.append(t, m, d);
        tip.hidden = false;
        // 贴着光标放，但别溢出画布
        const box = stage.getBoundingClientRect();
        const x = Math.min(at.x + 14, box.width - tip.offsetWidth - 8);
        const y = Math.min(at.y + 14, box.height - tip.offsetHeight - 8);
        tip.style.left = `${Math.max(8, x)}px`;
        tip.style.top = `${Math.max(8, y)}px`;
      }
      function hideTip() {
        tip.hidden = true;
      }
      svg.addEventListener('pointerleave', () => {
        hovered = null;
        hideTip();
      });

      /* ---------------------------------------------------------- 控件 */
      document.getElementById('graph-courses')?.addEventListener('click', (evt) => {
        const btn = evt.target.closest?.('[data-course]');
        if (!btn) return;
        course = btn.dataset.course || '';
        current = null;
        hideTip();
        for (const b of btn.parentElement.querySelectorAll('[data-course]')) {
          b.classList.toggle('is-active', b === btn);
        }
        render();
        fit();
      });

      document.getElementById('graph-relayout')?.addEventListener('click', () => {
        seed();
        tick(MAX_STEPS);
        render();
        fit();
      });

      document.getElementById('graph-fit')?.addEventListener('click', () => fit());

      labelsBtn?.addEventListener('click', () => {
        showLabels = !showLabels;
        labelsBtn.classList.toggle('is-on', showLabels);
        labelsBtn.setAttribute('aria-pressed', String(showLabels));
        render();
      });

      let searchTimer = 0;
      searchEl?.addEventListener('input', () => {
        clearTimeout(searchTimer);
        // 输入时不要每个字符都重画整张图
        searchTimer = window.setTimeout(() => {
          keyword = searchEl.value.trim().toLowerCase();
          render();
        }, 120);
      });

      /* ---------------------------------------------------------- 选中 */
      // 页面带 ?focus=xxx 进来时，把那个节点当作已选中
      const wantFocus = new URLSearchParams(location.search).get('focus');
      if (wantFocus && byId.has(wantFocus)) {
        current = wantFocus;
        course = byId.get(wantFocus).sub;
        for (const b of document.querySelectorAll('#graph-courses [data-course]')) {
          b.classList.toggle('is-active', (b.dataset.course || '') === course);
        }
      }

      /* ---------------------------------------------------------- 尺寸 */
      function resize() {
        const r = svg.getBoundingClientRect();
        W = Math.max(320, r.width);
        H = Math.max(280, r.height);
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        fit();
      }

      /* ---------------------------------------------------------- 启动 */
      resize();
      seed();
      tick(MAX_STEPS);
      render();
      fit();

      let rt = 0;
      window.addEventListener('resize', () => {
        clearTimeout(rt);
        rt = window.setTimeout(resize, 150);
      });
    })();
  </script>
</BaseLayout>

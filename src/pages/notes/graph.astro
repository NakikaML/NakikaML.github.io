---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contentNotes } from '../../utils/notes';
import { chapterOf } from '../../utils/toc';
import {
  courses,
  courseDeps,
  disciplines,
  disciplineOf,
  draftTitles,
  shortTitle,
} from '../../data/curriculum';

/**
 * 知识图谱 /notes/graph/
 * ============================================================
 * 一张**有向**的依赖图：箭头表示「先学 → 后学」。
 *
 * 最外一层是**学科分野**（opinion-18）：计算机科学 / 数学 ……
 * 每个分野在图上占一条横向底带，带内再按依赖分列。这样「这几门课是一伙的」
 * 由位置（同一条带）和配色（同一个色系）同时表达，不必再靠读者自己猜。
 *
 * 为什么不做标签关系网：标签是无向的，笔记一多每个节点都会被扯上好几根线，
 * 图会迅速变成一团毛线；而依赖是稀疏的、有向的、有因果的，正好也是读者真正
 * 需要的那条信息 —— 该按什么顺序学。
 *
 * 布局的四条硬约束（踩过的坑，别再动）：
 *   ① **课程节点的位置必须固定**。展开／收起绝不能挪动课程节点本身 ——
 *      否则"点一下展开"之后它就跳走了，用户按原位置再点会点空，
 *      表现就是"打不开也收不起来"。所以课程节点按**序号槽位**定位，
 *      与「展开了几门课」完全无关。
 *   ② 章节固定在**自己课程节点的正下方**一列，只沿纵向排；横向不许乱跑。
 *   ③ **分野自上而下堆叠，一个分野一条带**。带内分列、带间留空档；
 *      课程之间的先修箭头只往**同一条带里**走（跨分野的先修不要写进 courseDeps，
 *      写了也不会跨带画线，见下面的 groupOf）。
 *   ④ 首次进入**不默认展开任何一门课**：两个分野、九门课的整条路线要一眼看全。
 *      （以前默认展开章最多的那门，加了数学之后那条 12 章的树会把整个数学分野顶出画布。）
 */

const notes = await contentNotes();
const published = new Map(notes.map((n) => [n.id, n]));

const titleOf = (id) => published.get(id)?.data.title ?? draftTitles[id] ?? '';

interface GNode {
  id: string;
  kind: 'course' | 'note';
  label: string;
  course: string;
  /** 所属学科分野的 key（见 data/curriculum.ts 的 disciplines） */
  disc: string;
  count: number;
  live: number;
  planned: boolean;
  noteText: string;
  href?: string;
  draft: boolean;
  rank: number;
  /** 章号（从标题取；角标与信息卡显示的是它，不是 rank） */
  chapter: number;
  /** 固定格位 `[列, 行]`；null = 这门课走自动布局 */
  at: [number, number] | null;
  prereq: string[];
}

const nodes: GNode[] = [];
const edges: Array<{ s: string; t: string }> = [];
const courseOfNote = new Map<string, string>();
const discOfCourse = new Map<string, string>();

for (const c of courses) {
  const disc = disciplineOf(c);
  discOfCourse.set(c.id, disc);
  const usable = c.chapters.filter((ch) => titleOf(ch.id));
  for (const ch of usable) courseOfNote.set(ch.id, c.id);

  for (const ch of usable) {
    nodes.push({
      id: ch.id,
      kind: 'note',
      label: shortTitle(titleOf(ch.id), c.id),
      course: c.id,
      disc,
      count: 0,
      live: 0,
      planned: false,
      noteText: '',
      href: published.has(ch.id) ? `/notes/${ch.id}/` : undefined,
      draft: !published.has(ch.id),
      rank: 0,
      /**
       * 章号 —— 从完整标题里取（"C++程序设计基础-9 文件操作与重定向" → 9）。
       * 角标与信息卡都用它。**不能用 rank**：rank 是「树里的排位」，
       * 文件操作在树上排在面向对象之前，两者会差一位（踩过）。
       */
      chapter: chapterOf(titleOf(ch.id)),
      // 固定格位 `[列, 行]`：填了就不自动布局，照它摆（见 curriculum.ts 的 Chapter.at）
      at: ch.at ?? null,
      prereq: (ch.prereq ?? []).filter((p) => courseOfNote.has(p) || titleOf(p)),
    });
  }

  nodes.push({
    id: `course:${c.id}`,
    kind: 'course',
    label: c.id,
    course: c.id,
    disc,
    count: usable.length,
    live: usable.filter((ch) => published.has(ch.id)).length,
    planned: !!c.planned,
    noteText: c.note ?? '',
    draft: false,
    rank: 0,
    prereq: [],
  });
}

const byId = new Map(nodes.map((n) => [n.id, n]));

/**
 * 课内排序：按**依赖深度**（最长前驱链）分层，同层内保持 curriculum.ts 里的书写顺序。
 * 纵向位置因此天然满足「先修在上、后继在下」，不用手写序号。
 */
for (const c of courses) {
  const ids = nodes.filter((n) => n.kind === 'note' && n.course === c.id).map((n) => n.id);
  if (!ids.length) continue;
  const inSet = new Set(ids);
  const depth = new Map();
  const calc = (id, seen = new Set()) => {
    if (depth.has(id)) return depth.get(id);
    if (seen.has(id)) return 0; // 环保护：数据写错也不至于死循环
    seen.add(id);
    const n = byId.get(id);
    const ds = (n?.prereq ?? []).filter((p) => inSet.has(p)).map((p) => calc(p, seen) + 1);
    const d = ds.length ? Math.max(...ds) : 0;
    depth.set(id, d);
    return d;
  };
  for (const id of ids) calc(id);
  const order = new Map(ids.map((id, i) => [id, i]));
  [...ids]
    .sort((a, b) => depth.get(a) - depth.get(b) || order.get(a) - order.get(b))
    .forEach((id, i) => {
      const n = byId.get(id);
      if (n) n.rank = i + 1;
    });
}

/** 课程头 → 本课无课内先修的章；以及章与章之间的先修边 */
for (const c of courses) {
  const hdr = `course:${c.id}`;
  if (!byId.has(hdr)) continue;
  const inCourse = nodes.filter((n) => n.kind === 'note' && n.course === c.id);
  const inIds = new Set(inCourse.map((n) => n.id));
  for (const n of inCourse) {
    const inside = n.prereq.filter((p) => inIds.has(p));
    if (!inside.length) edges.push({ s: hdr, t: n.id });
    for (const p of inside) edges.push({ s: p, t: n.id });
  }
}

/** 课程之间的先修：显式写在 courseDeps 里，箭头 先学 → 后学。
 *  **跨分野的也画**（如「离散数学 → 数据结构与算法」）：那不是装饰，而是一个学生对
 *  「数学怎么服务计算机」的真实判断 —— 数学是数据结构与算法的先修。
 *  跨带的连线走两条带之间的空档 + 目标列旁的空档，绕开所有节点（见客户端的 crossEdgePath）。 */
for (const [after, before] of courseDeps) {
  if (!byId.has(`course:${after}`) || !byId.has(`course:${before}`)) continue;
  const cross = discOfCourse.get(after) !== discOfCourse.get(before);
  edges.push({ s: `course:${before}`, t: `course:${after}`, cross });
}

const payload = {
  nodes: nodes.map((n) => ({
    id: n.id,
    kind: n.kind,
    label: n.label,
    course: n.course,
    disc: n.disc,
    count: n.count,
    live: n.live,
    planned: n.planned,
    noteText: n.noteText,
    href: n.href,
    draft: n.draft,
    rank: n.rank,
    chapter: n.chapter,
    // 固定格位 `[列, 行]`（null = 交给自动布局）
    at: n.at,
    // 客户端要用它决定「树里谁是父节点」以及点亮先修链 ——
    // 漏掉这个字段会让脚本在 `.filter` 上直接抛错（踩过一次）
    prereq: n.prereq,
  })),
  edges,
  /**
   * 课程级先修（`[后学, 先学]`）。客户端按它给课程**分列**：
   * 列 = 依赖深度（左边是先学的，右边是后学的），同深度的课程在同一列里上下排。
   * 这里给的是**全部**依赖；分列时客户端只看同一分野内的那几条（跨带的连不参与排版），
   * 而画线时两种都画 —— 跨带的走单独一条绕行路径。
   */
  courseDeps: courseDeps.filter(
    ([after, before]) => byId.has(`course:${after}`) && byId.has(`course:${before}`)
  ),
  /** 学科分野：顺序即图上自上而下的顺序（见 curriculum.ts 的 disciplines） */
  disciplines: disciplines.map((d) => ({ key: d.key, label: d.label, note: d.note ?? '' })),
  courses: courses
    .filter((c) => byId.has(`course:${c.id}`))
    .map((c) => {
      const chs = nodes.filter((n) => n.kind === 'note' && n.course === c.id);
      return {
        id: c.id,
        disc: disciplineOf(c),
        // 课程头在分野带里的格位 `[列, 行]`（null = 退回按依赖深度自动分列）
        at: Array.isArray(c.at) ? c.at : null,
        total: chs.length,
        live: chs.filter((n) => !n.draft).length,
        planned: !!c.planned,
      };
    }),
};

const totalChapters = payload.nodes.filter((n) => n.kind === 'note').length;
const plannedCount = payload.courses.filter((c) => c.planned).length;
---

<BaseLayout
  title="知识图谱"
  description={`把 ${notes.length} 篇已发布笔记按「先学 → 后学」的依赖连成一张有向图，点击课程可展开每一章。`}
>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a>
      <span>/</span>
      <a href="/notes/">笔记</a>
      <span>/</span>
      <span>知识图谱</span>
    </nav>

    <div class="page-head">
      <p class="page-head__kicker">Knowledge Graph</p>
      <h1>知识图谱</h1>
      <p class="page-head__lede">
        箭头方向是<strong>学习的先后顺序</strong>：指着谁，就表示「先学完它，再学这个」。
        图按<strong>学科分野</strong>分成上下几条带（计算机科学 / 数学），
        一条带就是一个学科：带内从左往右是学习的先后，上下两行是并行的两条路线
        （比如「Java 一条」与「C++ 一条」、「高数一条」与「线代一条」）。
        点课程节点展开这门课的各章，再点收起。
        点某一章会亮起它的<strong>先修链</strong> —— 只亮「要先学的」，不亮后续；
        跨课程的先修也在同一条链上，所以链子亮到别的课程上，就表示那门课是它的前置。
        再点一次进入那篇笔记。
      </p>
    </div>

    <div class="graph-layout graph-page">
      <div class="graph-bar">
        <input
          class="graph-search"
          id="graph-search"
          type="search"
          placeholder="搜索章节名，命中会高亮…"
          aria-label="搜索章节"
        />
        <ul class="graph-legend" aria-label="学科分野图例">
          {
            disciplines.map((d) => (
              <li class="graph-legend__item" data-disc={d.key}>
                <i aria-hidden="true" />
                {d.label}
              </li>
            ))
          }
        </ul>
        <button type="button" class="graph-fit" id="graph-fit" title="把整张图缩放到刚好放进画布">
          适应窗口
        </button>
      </div>

      <div class="graph-stage">
        <svg
          class="graph-canvas"
          id="graph-canvas"
          role="img"
          aria-label={`${totalChapters} 章笔记与 ${payload.courses.length} 门课程按先修关系连成的有向图`}
        >
          <defs>
            <marker
              id="graph-arrow"
              viewBox="0 0 10 10"
              refX="9"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto-start-reverse"
            >
              <path d="M0 0 L10 5 L0 10 z" fill="#a89a89" />
            </marker>
            <marker
              id="graph-arrow-lit"
              viewBox="0 0 10 10"
              refX="9"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto-start-reverse"
            >
              <path d="M0 0 L10 5 L0 10 z" fill="#d78b34" />
            </marker>
          </defs>
          <g id="graph-viewport">
            <g id="graph-bands"></g>
            <g id="graph-links"></g>
            <g id="graph-nodes"></g>
          </g>
        </svg>
        <div class="graph-tip" id="graph-tip" hidden></div>
      </div>

      <p class="graph-note">
        每个<strong>学科分野</strong>一条横向底带；带内课程自左向右按<strong>先学 → 后学</strong>排开，
        各章挂在课程下方纵向展开。
        <strong>跨学科的先后</strong>用<strong>虚线</strong>表示（如「离散数学 → 数据结构与算法」：数学是计算机的地基）。
        点课程节点展开/收起（一次只看一门）；点某一章亮起它的<strong>先修链</strong>，再点一次进笔记。
        节点不可拖动 —— 空白处拖拽平移、滚轮缩放。虚线框 = <strong>预留课程</strong>或<strong>草稿章节</strong>，点它会提示、不会跳空页面。
        {plannedCount > 0 && `其中 ${plannedCount} 门是预留课程，笔记还在规划中。`}
      </p>
    </div>
  </div>

  <script type="application/json" id="graph-data" set:html={JSON.stringify(payload)} />

  <script>
    (() => {
      const raw = document.getElementById('graph-data')?.textContent;
      if (!raw) return;
      const data = JSON.parse(raw);
      if (!data.nodes?.length) return;

      const svg = document.getElementById('graph-canvas');
      const viewport = document.getElementById('graph-viewport');
      const bandLayer = document.getElementById('graph-bands');
      const linkLayer = document.getElementById('graph-links');
      const nodeLayer = document.getElementById('graph-nodes');
      const tip = document.getElementById('graph-tip');
      const stage = svg.parentElement;
      const searchEl = document.getElementById('graph-search');
      const SVGNS = 'http://www.w3.org/2000/svg';

      /* 节点与间距 */
      const NH = 30; // 节点高
      const HEAD_W = 132; // 课程节点宽
      const CH_W = 122; // 章节节点宽
      const VROW = 62; // 章节层与层之间的纵向步距
      const COURSE_GAP = 48; // 同一列里两门课之间的纵向间距
      const TREE_GAP = 46; // 课程行到它章节树的距离
      const SLOT = 150; // 树里相邻叶子的横向步距（节点宽 122 + 章号角标 22 + 余量）
      const CHIP_PAD = 22; // 章号角标在节点左侧额外占的横向空间
      const EDGE_INSET = 7; // 箭头端点离节点边缘的距离
      const TOP_RESERVE = 18; // 画布顶部至少留这么高（跨列绕行的通道在最上面）
      const BAND_HEAD = 58; // 分野带上沿到第一门课的距离：带标题与课程头的角标都写在这条带子里，留够别让它们撞上
      const BAND_FOOT = 18; // 最后一个节点到带下沿的距离
      const BAND_GAP = 44; // 两个分野带之间的空档（课程箭头借这里走）

      let W = 900;
      let H = 640;

      const nodes = data.nodes.map((n) => ({ ...n, x: 0, y: 0, homeX: 0, homeY: 0 }));
      const byId = new Map(nodes.map((n) => [n.id, n]));
      const courseIds = data.courses.map((c) => c.id);
      const discLabel = new Map((data.disciplines ?? []).map((d) => [d.key, d.label]));

      /* 展开状态：**默认一门都不展开**。
         以前默认展开章最多的那门（12 章的 C++），好让读者一进来就看见「章」这一层；
         但加了数学分野之后，那条 12 层的树会把整条数学带顶到画布外面去 ——
         而「几个学科、每门课怎么排」才是第一眼最该看见的路线图。
         展开交给读者点（一次只看一门，图才稀疏）。 */
      const expanded = new Set();

      const isVisible = (n) => n.kind === 'course' || expanded.has(n.course);
      const visibleNodes = () => nodes.filter(isVisible);
      const nodeW = (n) => (n.kind === 'course' ? HEAD_W : CH_W);

      /* ------------------------------------------------- 章节图（分层布局）
         一门课的章节按「依赖深度」分层（rank），层内横向排开，连线画成平滑曲线。
         这是标准的**分层有向图**排法（Sugiyama / dagre 那一套，Mermaid 用的也是它）：

           ① rank = 最长课内先修链：先修一定在上面一行；
           ② **跨层的连线插入「虚拟节点」**（不可见）占住中间那层的空位 ——
              长连线因此能绕开节点，不会从别人头上压过去；
           ③ 层内次序用**重心法**迭代：谁的先修/后继在哪边，它就往那边靠；
           ④ 连线画成三次贝塞尔：从上游底边中点垂下来、再从目标顶边中点垂进去。

         为什么不再用「父子树 + 槽位」：树只能表达「一个父节点」，
         而这里 HM-8 有 HM-3、HM-7 两个先修，HM-9 有 HM-5、HM-8 两个先修。
         硬塞进一棵树就得挑一个当爹、另一个另画 —— 上一版那些「一条线横穿全图、
         看着像连到别人身上」的毛病就是这么来的。 */
      function buildTree(cid) {
        const chapters = nodes.filter((n) => n.kind === 'note' && n.course === cid);
        const out = { chapters, rank: new Map(), layers: [], edges: [], pos: new Map(), w: 0, h: 0, rows: 0, cols: new Map() };
        if (!chapters.length) return out;

        const ids = new Set(chapters.map((c) => c.id));
        const map = new Map(chapters.map((c) => [c.id, c]));

        /* ⓪ **固定格位优先**：数据里给了 `at: [列, 行]` 就完全照它摆，
              不做任何自动排序（作者的图长什么样，就画成什么样）。 */
        const fixed = chapters.every((c) => Array.isArray(c.at));
        out.fixed = fixed;
        if (fixed) {
          let rows = 1;
          let minC = Infinity;
          let maxC = -Infinity;
          for (const c of chapters) {
            const [col, row] = c.at;
            out.rank.set(c.id, row);
            out.cols.set(c.id, col);
            rows = Math.max(rows, row);
            minC = Math.min(minC, col);
            maxC = Math.max(maxC, col);
          }
          for (let r = 1; r <= rows; r++) out.layers.push([]);
          for (const c of chapters) out.layers[out.rank.get(c.id) - 1].push(c.id);
          for (const l of out.layers) l.sort((a, b) => out.cols.get(a) - out.cols.get(b));
          for (const c of chapters) {
            const ins = (c.prereq ?? []).filter((x) => ids.has(x));
            for (const p of ins) out.edges.push({ real: true, src: p, dst: c.id });
          }
          out.w = (maxC - minC) * SLOT + CH_W;
          out.h = rows * VROW;
          out.rows = rows;
          out.minCol = minC;
          out.maxCol = maxC;
          return out;
        }

        /* ① 分层：rank = 最长课内先修链 + 1 */
        const rankOf = (node, seen = new Set()) => {
          if (out.rank.has(node.id)) return out.rank.get(node.id);
          if (seen.has(node.id)) return 1; // 环保护：数据写错也不至于死循环
          seen.add(node.id);
          const ins = (node.prereq ?? []).filter((p) => ids.has(p));
          const r = ins.length ? Math.max(...ins.map((p) => rankOf(map.get(p), seen))) + 1 : 1;
          out.rank.set(node.id, r);
          return r;
        };
        let depth = 1;
        for (const c of chapters) depth = Math.max(depth, rankOf(c));

        /* ② 边 + 虚拟节点：跨层的边拆成逐层小段，中间由虚拟节点占位。
              每段都记着这条链的**真实起点/终点** —— 点亮先修链时按它判断，虚拟节点不参与。 */
        let vseq = 0;
        const edges = [];
        for (const c of chapters) {
          for (const p of (c.prereq ?? []).filter((x) => ids.has(x))) {
            const r1 = out.rank.get(p);
            const r2 = out.rank.get(c.id);
            let prev = p;
            for (let r = r1 + 1; r < r2; r++) {
              const v = `__v${vseq++}`;
              out.rank.set(v, r);
              edges.push({ from: prev, to: v, virtual: true, src: p, dst: c.id });
              prev = v;
            }
            edges.push({ from: prev, to: c.id, real: true, src: p, dst: c.id });
          }
        }
        out.edges = edges;

        /* ③ 层内初始次序：真实节点按章号；虚拟节点先跟在上游后面 */
        for (let r = 1; r <= depth; r++) out.layers.push([]);
        for (const c of chapters) out.layers[out.rank.get(c.id) - 1].push(c.id);
        for (const l of out.layers) l.sort((a, b) => (map.get(a)?.rank ?? 999) - (map.get(b)?.rank ?? 999));
        for (const e of edges) {
          if (!e.virtual) continue;
          const layer = out.layers[out.rank.get(e.to) - 1];
          if (!layer.includes(e.to)) layer.push(e.to);
        }

        /* ④ 重心法：往下扫看先修、往上扫看后继，来回 4 趟 */
        const preds = new Map();
        const succs = new Map();
        for (const e of edges) {
          if (!preds.has(e.to)) preds.set(e.to, []);
          preds.get(e.to).push(e.from);
          if (!succs.has(e.from)) succs.set(e.from, []);
          succs.get(e.from).push(e.to);
        }
        const indexOf = (layer) => new Map(layer.map((id, i) => [id, i]));
        for (let pass = 0; pass < 4; pass++) {
          const down = pass % 2 === 0;
          const order = [...out.layers.keys()];
          if (!down) order.reverse();
          for (const li of order) {
            const rel = down ? li - 1 : li + 1;
            if (rel < 0 || rel >= out.layers.length) continue;
            const posOf = indexOf(out.layers[rel]);
            const cur = indexOf(out.layers[li]);
            const keyOf = (id) => {
              const nb = (down ? preds.get(id) : succs.get(id)) ?? [];
              const vals = nb.map((n) => posOf.get(n)).filter((v) => v !== undefined);
              return vals.length ? vals.reduce((a, b) => a + b, 0) / vals.length : cur.get(id) ?? 0;
            };
            const keyed = out.layers[li].map((id) => [id, keyOf(id)]);
            keyed.sort((a, b) => a[1] - b[1] || (a[0] < b[0] ? -1 : 1));
            out.layers[li] = keyed.map(([id]) => id);
          }
        }

        /* ⑤ 尺寸：宽看最宽的一层，高看层数 */
        const maxLen = Math.max(...out.layers.map((l) => l.length));
        out.w = (maxLen - 1) * SLOT + CH_W;
        out.h = depth * VROW;
        out.rows = depth;
        return out;
      }

      const trees = new Map(courseIds.map((cid) => [cid, buildTree(cid)]));

      /** 这门课的章节图占多大（静态）：宽看最宽的层、高看层数 */
      function treeSize(cid) {
        const t = trees.get(cid);
        if (!t || !t.chapters.length) return { w: 0, h: 0 };
        return { w: t.w, h: t.h };
      }

      /* --------------------------------------------- 学科分野 → 全局列网格
         最外一层是**分野**（data.disciplines 的顺序 = 图上自上而下的顺序）：
         每个分野一条横向底带，带内是**列 × 行**的网格。
           · 列 = 学习的先后（左先右后）。**列号是全图共用的** —— 同一个列号在两条带里
             落在同一条竖线上，所以「离散数学」正好在「C++程序设计基础」的正上方，
             它那条跨带虚线才能和 C++ 的箭头并成同一支（作者 2026-10 的草图）。
           · 行 = 带内并行的两条路线（0 在上），行号只在本带内有意义。
         格位由 curriculum.ts 的 `Course.at: [列, 行]` 直接给，不用算法去猜；
         没填 `at` 的课退回老办法：列 = 依赖深度、行 = 0。
         列宽与章节树宽度完全无关：一次只展开一门课，它宽出去的那片地方本来就是空的
         （所以列宽不必为最宽的树预留 —— 那会让整张图被撑宽、缩放被压小）。 */
      const colOf = new Map(); // 课程 id → 列
      const rowOf = new Map(); // 课程 id → 行（0 起）
      const groups = []; // 分野带，自上而下
      {
        const deps = data.courseDeps ?? [];
        const discOf = new Map(data.courses.map((c) => [c.id, c.disc ?? 'cs']));
        // 兜底：数据里出现了没登记的分野 key，就单独给它一条带（宁可多一条，也别把课漏掉）
        const order = [...(data.disciplines ?? []).map((d) => d.key)];
        for (const c of data.courses) {
          const k = discOf.get(c.id);
          if (!order.includes(k)) order.push(k);
        }

        for (const key of order) {
          const list = data.courses.filter((c) => discOf.get(c.id) === key);
          if (!list.length) continue;

          const inGroup = new Set(list.map((c) => c.id));
          const memo = new Map();
          const depthOfCourse = (cid, seen = new Set()) => {
            if (memo.has(cid)) return memo.get(cid);
            if (seen.has(cid)) return 0; // 环保护
            seen.add(cid);
            const pres = deps
              .filter(([after, before]) => after === cid && inGroup.has(before))
              .map(([, before]) => before);
            const d = pres.length ? Math.max(...pres.map((p) => depthOfCourse(p, seen) + 1)) : 0;
            memo.set(cid, d);
            return d;
          };

          /* 每门课落在哪一格：`at` 填了就用（钉死），没填的列 = 依赖深度、行 = 0 */
          const slotOf = new Map();
          for (const c of list) {
            slotOf.set(
              c.id,
              Array.isArray(c.at)
                ? { col: c.at[0], row: c.at[1] }
                : { col: depthOfCourse(c.id), row: 0 }
            );
          }

          const group = {
            key,
            label: discLabel.get(key) ?? key,
            columns: [],
            courses: list.map((c) => c.id),
            rows: 1,
            y0: 0,
            y1: 0,
            bandLeft: 0,
            bandRight: 0,
          };

          const colKeys = [...new Set([...slotOf.values()].map((s) => s.col))].sort((a, b) => a - b);
          for (const ck of colKeys) {
            // 同一列里按行号从上往下排（行号相同就按 curriculum.ts 的书写顺序）
            const cids = list
              .filter((c) => slotOf.get(c.id).col === ck)
              .map((c) => c.id)
              .sort(
                (a, b) =>
                  slotOf.get(a).row - slotOf.get(b).row ||
                  courseIds.indexOf(a) - courseIds.indexOf(b)
              );
            const col = { c: ck, list: cids, left: 0, right: 0, x: 0, group };
            group.columns.push(col);
            for (const cid of cids) colOf.set(cid, col);
          }
          for (const [cid, s] of slotOf) {
            rowOf.set(cid, s.row);
            group.rows = Math.max(group.rows, s.row + 1);
          }
          groups.push(group);
        }
      }

      const groupOf = new Map(groups.map((g) => [g.key, g]));

      /** 展开的那门课 → 它的章节树干（树的顶边 y），画「课程头 → 入口章」连线时要走这个高度 */
      const treeTopOf = new Map();

      /* ---------------------------------------------------------- 定位
         ⚠️ 五条硬约束，改之前先读：
         ① **课程节点不会因为「自己被展开」而移动**：横向只由所在列决定，纵向只由
            它的 `at` 行号决定（行号相同的课头齐平）。否则点一下展开它就跳走，
            用户按原位再点会点空 —— 这就是 bug-9。
         ② **课程行在上、章节树在下**，两件事互不占位：
            · 课程行 = 带内 列 × 行 的网格（**树不再挤在格子里**，所以同一行的课程头是齐的）；
            · 章节树 = 一整块挂在**所有课程行之下**，横向对准自己那门课（超宽时夹进分野带里）。
            这样展开一门课不会把它下面的课程顶下去，「一次看一门」也不会有半截树露在缝里。
         ③ **节点一律不可拖动**：位置完全由 `at` 与依赖算定，每次重排结果都一样。
         ④ **分野带自上而下堆叠**：上面那条带长高，下面那条带整体下移 —— 带内相对位置不变。
         ⑤ **内容永远不出画布**：树宽夹在带内；画布高度按内容算（见 fit），
            内容变高画布就跟着长高，绝不把节点切掉半截。
         `fit('keep')` 只横向居中，纵向与缩放不动，屏幕位置因此全程稳定。 */
      function layout() {
        const vis = visibleNodes();
        // 两端留白随宽度走（窄屏也别贴边）；分野带比列再宽出去一点，把课程头包住
        const side = Math.max(70, Math.min(150, W * 0.085));
        const bandInset = Math.max(18, side - 52);

        /* ⓪ 基准列位：列号是**全局**的 —— 两条带里同一个列号落在同一条竖线上。
              所以「离散数学」正好压在「C++程序设计基础」头顶上，跨带那条虚线抬上去以后
              能直接落进 C++→数据结构与算法 那支箭头的竖轨里，合成一支。 */
        const maxCol = Math.max(0, ...groups.flatMap((g) => g.columns.map((c) => c.c)));
        const pitch = (W - side * 2) / (maxCol + 1);
        const colX = (c) => side + pitch * c + pitch / 2;
        for (const g of groups) {
          g.bandLeft = bandInset;
          g.bandRight = W - bandInset;
          for (const col of g.columns) {
            col.x = colX(col.c);
            col.left = col.x - pitch / 2;
            col.right = col.x + pitch / 2;
          }
        }

        let cursor = TOP_RESERVE;
        for (const g of groups) {
          g.y0 = cursor;
          g.bandLeft = bandInset;
          g.bandRight = W - bandInset;

          /* ① 课程行：只排课程头，纵向由 `at` 的行号决定 */
          const top = g.y0 + BAND_HEAD;
          let rowBottom = top;

          for (const col of g.columns) {
            for (const cid of col.list) {
              const head = byId.get(`course:${cid}`);
              if (!head) continue;
              const row = rowOf.get(cid) ?? 0;
              head.homeX = col.x;
              head.homeY = top + row * (NH + COURSE_GAP);
              rowBottom = Math.max(rowBottom, head.homeY + NH / 2);
            }
          }

          /* ② 章节树：挂在课程行下方的一整块，横向对准自己那门课，超宽就往画布边夹 */
          let treeBottom = rowBottom;
          for (const cid of g.courses) {
            if (!expanded.has(cid)) continue;
            const size = treeSize(cid);
            if (!size.h) continue;
            const head = byId.get(`course:${cid}`);
            const cx = head ? head.homeX : W / 2;
            // 让整棵树（含左侧章号角标）留在画布里：能对准课程头就对准，装不下才夹住
            const half = size.w / 2 + CHIP_PAD / 2;
            const lo = bandInset + half + 12;
            const hi = W - bandInset - half - 12;
            const treeCx = lo > hi ? W / 2 : Math.min(hi, Math.max(lo, cx));

            const treeTop = treeBottom + TREE_GAP;
            placeTree(cid, treeCx, treeTop);
            treeTopOf.set(cid, treeTop - NH / 2);
            treeBottom = treeTop + size.h;
          }

          /* ③ 带子的左右边 = 本带内容实际占的地方 + 留白。
             所以「数学」带比「计算机科学」带窄、而且靠左 —— 就像草图里那样，
             两条带的边不是同一条竖线，读者一眼能看出它们各占哪几列。 */
          let lo = Infinity;
          let hi = -Infinity;
          for (const cid of g.courses) {
            const head = byId.get(`course:${cid}`);
            if (!head) continue;
            lo = Math.min(lo, head.homeX - HEAD_W / 2);
            hi = Math.max(hi, head.homeX + HEAD_W / 2);
            const t = trees.get(cid);
            if (!t || !expanded.has(cid)) continue;
            for (const c of t.chapters) {
              const p = t.pos.get(c.id);
              if (!p) continue;
              lo = Math.min(lo, p.x - CH_W / 2 - CHIP_PAD);
              hi = Math.max(hi, p.x + CH_W / 2);
            }
          }
          if (Number.isFinite(lo)) {
            g.bandLeft = Math.max(bandInset, lo - 30);
            g.bandRight = Math.min(W - bandInset, Math.max(hi + 30, g.bandLeft + 160));
          }

          g.y1 = Math.max(rowBottom, treeBottom) + BAND_FOOT;
          cursor = g.y1 + BAND_GAP;
        }

        // 位置完全由依赖关系算定（节点不可拖动）—— 每次重排结果都一样
        for (const node of vis) {
          node.x = node.homeX;
          node.y = node.homeY;
        }
      }

      /** 把一门课的章节图摆到 (cx, top)：固定格位的照 `at` 摆，其余按层等距摊开 */
      function placeTree(cid, cx, top) {
        const t = trees.get(cid);
        if (!t || !t.chapters.length) return;
        if (t.fixed) {
          const mid = (t.minCol + t.maxCol) / 2;
          for (const c of t.chapters) {
            const col = t.cols.get(c.id);
            const row = t.rank.get(c.id);
            const x = cx + (col - mid) * SLOT;
            const y = top + (row - 1) * VROW;
            t.pos.set(c.id, { x, y });
            const node = byId.get(c.id);
            if (node) {
              node.homeX = x;
              node.homeY = y;
            }
          }
          return;
        }
        for (const [li, layer] of t.layers.entries()) {
          const n = layer.length;
          for (const [i, id] of layer.entries()) {
            const x = cx + (i - (n - 1) / 2) * SLOT;
            const y = top + li * VROW;
            t.pos.set(id, { x, y });
            const node = byId.get(id);
            if (node) {
              node.homeX = x;
              node.homeY = y;
            }
          }
        }
      }

      /* ---------------------------------------------------------- 选中 / 搜索 */
      const lit = new Set();
      let current = null;
      let keyword = '';

      // 图上的边。两种：
      //   · 章节边：课程头 → 入口章，以及章 → 章（一个章节有几个先修就有几条，一律实线肘形）；
      //   · 课程边：课程 → 课程，来自 curriculum.ts 的 courseDeps。
      // 注意：「建树用哪个父节点」（children 排序时取课内先修里最靠前的那个，见 buildTree）
      // 只影响**节点摆在哪**，不影响画线 —— 所有先修都画成一样的箭头，前置没有主次。
      const edges = data.edges
        .map((e) => {
          const s = byId.get(e.s);
          const t = byId.get(e.t);
          if (!s || !t || s === t) return null;
          return { s, t, cross: !!e.cross };
        })
        .filter(Boolean);

      /* 「先修链」的邻接表 —— 只记「要先学谁」，不记后继（理由见下）。
         两个来源：
           ① 画出来的边：课内先修，以及「入口章挂在课程头上」那一条；
           ② **跨课程章节先修**（如 DSA-2 线性表要先用过 CPP-5/6/7）—— 它不在画出来的边上：
              图一次只展开一门课，这条边的另一头永远是收起的，画成常驻线只能是一条
              横穿画布的长线。所以它不进画布、只进这张表 ——
              点亮先修链时会顺着它亮到那门课的课程头（课程级箭头也会一起亮，
              正好解释了「为什么另一门课也亮着」），信息卡里再写清楚是哪门课的第几章。
         为什么不记后继：读者点某一章问的是「我要先学什么」，不是「学完能干什么」。
         后继早就由箭头方向表达了，再点亮一次只会把高亮摊满整门课，
         反而稀释「这些才是我的前置」这个信号。 */
      const prereqOf = new Map();
      const addPre = (id, pre) => {
        if (!prereqOf.has(id)) prereqOf.set(id, []);
        if (!prereqOf.get(id).includes(pre)) prereqOf.get(id).push(pre);
      };
      for (const e of edges) addPre(e.t.id, e.s.id);
      for (const n of nodes) {
        if (n.kind !== 'note') continue;
        for (const p of n.prereq ?? []) if (byId.has(p)) addPre(n.id, p);
      }

      function rebuildLit() {
        lit.clear();
        if (!current) return;
        lit.add(current);
        const up = [current];
        while (up.length) {
          for (const p of prereqOf.get(up.pop()) ?? []) {
            if (!lit.has(p) && byId.has(p)) {
              lit.add(p);
              up.push(p);
            }
          }
        }
      }

      /**
       * 课程 → 课程的连线：**先并在一起，只留一支箭头**（作者 2026-10 的草图）。
       *
       * 不再「一条先修一条线」，而是以**目标课程**为中心组织：
       *   · 所有先修都先汇到目标**左侧的那根竖轨**上，竖轨摆在**源列与目标列之间的正中间**
       *     （贴目标框会让所有竖轨挤在画面右侧；摆中间则两边留白对称、箭头也够长）；
       *   · 竖轨跨越几行就跨几行，最后在目标那一行**只横着扎一支箭头**进去；
       *   · 于是「C++ 与离散数学 → 数据结构与算法」看着是两条线汇成一支箭头，
       *     而「高等数学 → 离散数学 / 概率论与数理统计」看着是一根主干分两叉。
       *
       * 三条走法：
       *   ① 同带、源在目标左边 → 从源右缘横着走到竖轨（同一行时这段就是箭头那一段）；
       *   ② 同带、但中间还隔着别的课（同一行上有障碍）→ 抬到行间缝里走一段再落下，
       *      绝不横穿别人的节点；
       *   ③ 源在目标**右边**（跨分野时列位不一定谁左谁右，见「离散数学 → 数据结构与算法」，
       *      数学带只有两列，离散会落在结构表的右边）→ 先往右出、竖直抬到行间缝，
       *      再横着折回来接竖轨。整条线仍然只在空档里走。
       *
       * 一条线画完 push 进 out，由 render 统一挂到图层上（便于统一明暗）。
       */
      function courseLinkSegments() {
        const feeds = new Map(); // 目标课程 id → 汇入它的那些边
        for (const e of edges) {
          if (e.s.kind !== 'course' || e.t.kind !== 'course') continue;
          if (!isVisible(e.s) || !isVisible(e.t)) continue;
          if (!feeds.has(e.t.id)) feeds.set(e.t.id, []);
          feeds.get(e.t.id).push(e);
        }

        const out = [];
        const seen = new Set(); // 同一段线可能被两个目标各画一次（共用一根竖轨），只留一条
        const push = (d, op) => {
          if (!op.arrow) {
            if (seen.has(d)) return;
            seen.add(d);
          }
          out.push({ d, ...op });
        };

        for (const [tid, list] of feeds) {
          const t = byId.get(tid);
          if (!t) continue;
          const tCol = colOf.get(t.course);
          /* 竖轨摆在**源列与目标列之间的正中间**，不是贴着目标框 ——
             贴着目标框的时候所有竖轨都挤在画面右侧，看着一坨；
             放中间以后「分出/汇入」的那根主干落在两列的空档中央，两边留白对称。 */
          let srcRight = -Infinity;
          if (tCol) {
            for (const e of list) {
              const sc = colOf.get(e.s.course);
              if (sc && sc.c < tCol.c) srcRight = Math.max(srcRight, sc.right);
            }
          }
          const railX =
            Number.isFinite(srcRight) && tCol
              ? (srcRight + tCol.left) / 2
              : t.x - HEAD_W / 2 - 12;
          const tipX = t.x - HEAD_W / 2 - EDGE_INSET;
          const isLit = !!current && list.some((e) => lit.has(e.s.id) && lit.has(e.t.id));
          const arrive = []; // 竖轨要串起来的 y

          /* 行间缝：行与行之间那道空档。目标在最上面那行时改从下方绕（上面是带标题区）。 */
          const gapY =
            (rowOf.get(t.course) ?? 0) > 0
              ? t.y - (NH + COURSE_GAP) / 2
              : t.y + (NH + COURSE_GAP) / 2;

          for (const e of list) {
            const s = e.s;
            const sx = s.x + HEAD_W / 2 + EDGE_INSET;
            const sy = s.y;
            // 这一段横着走会不会撞到同一行上的其它课程？
            const blocked = visibleNodes().some(
              (n) =>
                n.kind === 'course' &&
                n !== s &&
                Math.abs(n.y - sy) < NH / 2 + 2 &&
                n.x > Math.min(sx, railX) + 1 &&
                n.x < Math.max(sx, railX) - 1
            );

            if (sx <= railX + 0.5 && !blocked) {
              /* ① 正常：横着汇进竖轨 */
              arrive.push(sy);
              if (Math.abs(sy - t.y) > 0.5 || sx < railX - 0.5) {
                push(`M${sx},${sy} L${railX},${sy}`, { lit: isLit, cross: e.cross });
              }
              continue;
            }

            /* ②③ 需要绕：往右出一小段 → 抬/压到行间缝 → 横着折回竖轨 */
            const laneX = sx + 24;
            arrive.push(gapY);
            push(
              [
                `M${sx},${sy}`,
                `L${laneX},${sy}`,
                `L${laneX},${gapY}`,
                `L${railX},${gapY}`,
              ].join(' '),
              { lit: isLit, cross: e.cross }
            );
          }

          /* 竖轨：把这几个落点串起来（只有一个落点、且正好在目标那一行时不必画） */
          arrive.push(t.y);
          const y0 = Math.min(...arrive);
          const y1 = Math.max(...arrive);
          if (y1 - y0 > 0.5) {
            push(`M${railX},${y0} L${railX},${y1}`, {
              lit: isLit,
              cross: list.every((e) => e.cross),
              rail: true,
            });
          }
          /* 一支箭头扎进目标（合流的都走这一支） */
          push(`M${railX},${t.y} L${tipX},${t.y}`, {
            lit: isLit,
            cross: list.every((e) => e.cross),
            arrow: true,
          });
        }
        return out;
      }

      /* ---------------------------------------------------------- 渲染 */
      function render() {
        const vis = visibleNodes();
        linkLayer.replaceChildren();
        nodeLayer.replaceChildren();
        bandLayer.replaceChildren();

        /* 分野底带：一条带 = 一个学科。带子用分野色系的极浅填充，标题写在带子左上角。
           位置由 layout() 算好（含展开带来的高度变化），这里只负责画出来。 */
        for (const g of groups) {
          const band = document.createElementNS(SVGNS, 'rect');
          band.setAttribute('x', String(g.bandLeft));
          band.setAttribute('y', String(g.y0));
          band.setAttribute('width', String(Math.max(1, g.bandRight - g.bandLeft)));
          band.setAttribute('height', String(Math.max(1, g.y1 - g.y0)));
          band.setAttribute('rx', '16');
          band.setAttribute('class', 'graph-band');
          band.setAttribute('data-disc', g.key);
          bandLayer.appendChild(band);

          const chapterCount = g.courses.reduce((n, cid) => {
            const c = data.courses.find((x) => x.id === cid);
            return n + (c ? c.total : 0);
          }, 0);
          const label = document.createElementNS(SVGNS, 'text');
          label.setAttribute('x', String(g.bandLeft + 18));
          label.setAttribute('y', String(g.y0 + 23));
          label.setAttribute('class', 'graph-band__label');
          label.setAttribute('data-disc', g.key);
          label.textContent = `${g.label} · ${g.courses.length} 门课 · ${chapterCount} 章`;
          bandLayer.appendChild(label);
        }

        /* 课程级箭头：先修先汇到目标的竖轨上，再一支箭头扎进去（见 courseLinkSegments） */
        for (const seg of courseLinkSegments()) {
          const path = document.createElementNS(SVGNS, 'path');
          path.setAttribute('d', seg.d);
          path.setAttribute('fill', 'none');
          path.setAttribute(
            'class',
            'graph-link graph-link--course' +
              (seg.cross ? ' graph-link--cross' : '') +
              (seg.lit ? ' is-lit' : current ? ' is-dim' : '')
          );
          // 只有最后一支「扎进目标」的线段带箭头 —— 合流的几条共用它
          if (seg.arrow) path.setAttribute('marker-end', seg.lit ? 'url(#graph-arrow-lit)' : 'url(#graph-arrow)');
          linkLayer.appendChild(path);
        }

        /* 「课程头 → 入口章」的连线：树现在挂在**课程行下方**，所以要绕着走 ——
           从课程头右缘出 → 沿列间空档竖直下到树上方那道缝 → 横向对准目标 → 扎进目标。
           竖直段走的是**列与列之间的空档**（那里永远没有节点），横向段走的是
           **课程行与树之间的缝**，所以这条线一个节点都不会压到。 */
        for (const e of edges) {
          if (e.s.kind !== 'course' || e.t.kind !== 'note') continue;
          if (!isVisible(e.s) || !isVisible(e.t)) continue;
          const treeTop = treeTopOf.get(e.s.course);
          const sx = e.s.x + HEAD_W / 2 + EDGE_INSET;
          const sy = e.s.y;
          // 横线放在树顶上方那道缝里（与章节母线同一高度带）
          const laneY = (treeTop ?? e.t.y - VROW) + NH / 2 + 6;
          const laneX = sx + 10;
          const d = [
            `M${sx},${sy}`,
            `L${laneX},${sy}`,
            `L${laneX},${laneY}`,
            `L${e.t.x},${laneY}`,
            `L${e.t.x},${e.t.y - NH / 2}`,
          ].join(' ');
          const isLit = !!current && lit.has(e.s.id) && lit.has(e.t.id);
          const path = document.createElementNS(SVGNS, 'path');
          path.setAttribute('d', d);
          path.setAttribute('fill', 'none');
          path.setAttribute('class', 'graph-link graph-link--course' + (isLit ? ' is-lit' : current ? ' is-dim' : ''));
          path.setAttribute('marker-end', isLit ? 'url(#graph-arrow-lit)' : 'url(#graph-arrow)');
          linkLayer.appendChild(path);
        }

        /* 章节先修线：**一棵树的画法** —— 分叉先并成一条主干，再各自落下。
           （作者的原话：分叉先并在一起更好看。空间格局已经定死，线要自己「长成一棵树」。）

           三条规则，合起来就是手画的那张图：
             ① **分叉**：一个先修有 ≥2 个子节点 → 从它底边垂一根**主干**到母线，
                母线上横着铺开，再各自落下、各带一支箭头（不是每个子节点各拉一条竖线）；
             ② **合流**：一个章节有 ≥2 个先修 → 这些先修的竖线汇到**同一条母线**上，
                只用**一支**箭头扎进它（先修没有主次，读者也不必去数箭头）；
             ③ **直连**：一对一（无分叉、无合流）→ 一根竖线 + 落地处补一小段横线。
           母线高度按目标所在行统一算（行内再按跨度错开 6px），
           这样同一行的线不会首尾相接连成一条贯通全宽的大线（bug-13）。 */
        for (const cid of expanded) {
          const t = trees.get(cid);
          if (!t || !t.chapters.length) continue;

          /* 先整理出每章的先修（课内）与子节点，入口章由课程头那段连线负责，不在这里 */
          const parentsOf = new Map(); // 章 id → [先修 id]
          const kidsOf = new Map(); // 章 id → [子节点 id]
          for (const c of t.chapters) {
            const ps = (c.prereq ?? []).filter((p) => t.pos.has(p));
            if (ps.length) parentsOf.set(c.id, ps);
            for (const p of ps) {
              if (!kidsOf.has(p)) kidsOf.set(p, []);
              kidsOf.get(p).push(c.id);
            }
          }
          const xy = (id) => t.pos.get(id);
          /** 母线高度：目标上方那道缝，按行内序号错开 6px */
          const busYOf = (childId) => {
            const c = xy(childId);
            const nmates = t.chapters.filter((n) => xy(n.id)?.y === c.y && parentsOf.has(n.id)).length;
            if (nmates <= 1) return c.y - NH / 2 - 10;
            const list = t.chapters
              .filter((n) => xy(n.id)?.y === c.y && parentsOf.has(n.id))
              .map((n) => {
                const xs = [...(parentsOf.get(n.id) ?? []).map((p) => xy(p).x), xy(n.id).x];
                return { id: n.id, span: Math.max(...xs) - Math.min(...xs) };
              })
              .sort((a, b) => b.span - a.span);
            const k = list.findIndex((x) => x.id === childId);
            return c.y - NH / 2 - 10 - Math.max(0, k) * 6;
          };

          /** 一条线画完就 push 进来，最后一起挂到图层上（便于统一明暗） */
          const draw = (d, isLit) => {
            const path = document.createElementNS(SVGNS, 'path');
            path.setAttribute('d', d);
            path.setAttribute('fill', 'none');
            path.setAttribute('class', 'graph-link graph-link--chapter' + (isLit ? ' is-lit' : current ? ' is-dim' : ''));
            path.setAttribute('marker-end', isLit ? 'url(#graph-arrow-lit)' : 'url(#graph-arrow)');
            linkLayer.appendChild(path);
          };
          const litOf = (ids) => !!current && ids.every((id) => lit.has(id));

          /* ① 分叉：先修有 ≥2 个子节点 —— 主干先下来，再在母线上分开 */
          for (const [pid, kids] of kidsOf) {
            if (kids.length < 2) continue;
            const p = xy(pid);
            // 同一行里的子节点才共用一条母线；跨行的分组处理
            const groups = new Map();
            for (const kid of kids) {
              const k = xy(kid);
              if (!groups.has(k.y)) groups.set(k.y, []);
              groups.get(k.y).push(kid);
            }
            for (const [rowY, group] of groups) {
              if (group.length < 2) continue;
              const busY = rowY - NH / 2 - 10;
              const xs = group.map((kid) => xy(kid).x);
              const lo = Math.min(...xs, p.x);
              const hi = Math.max(...xs, p.x);
              const d = [
                `M${p.x},${p.y + NH / 2} L${p.x},${busY}`,
                hi - lo > 0.5 ? `M${lo},${busY} L${hi},${busY}` : '',
                ...group.map((kid) => `M${xy(kid).x},${busY} L${xy(kid).x},${xy(kid).y - NH / 2}`),
              ]
                .filter(Boolean)
                .join(' ');
              draw(d, litOf([pid, ...group]));
            }
          }

          /* ② 合流 / ③ 直连：按目标逐个处理 */
          for (const [childId, parents] of parentsOf) {
            const c = xy(childId);
            const busY = busYOf(childId);
            if (parents.length >= 2) {
              // 多个先修：竖线各自下来，汇到同一条母线，再用一支箭头扎进目标
              const xs = [...parents.map((p) => xy(p).x), c.x];
              const lo = Math.min(...xs);
              const hi = Math.max(...xs);
              const d = [
                ...parents.map((p) => `M${xy(p).x},${xy(p).y + NH / 2} L${xy(p).x},${busY}`),
                hi - lo > 0.5 ? `M${lo},${busY} L${hi},${busY}` : '',
                `M${c.x},${busY} L${c.x},${c.y - NH / 2}`,
              ]
                .filter(Boolean)
                .join(' ');
              draw(d, litOf([childId, ...parents]));
              continue;
            }
            // 单个先修：若它已经在 ① 里作为「分叉主干」画过（子节点 ≥2 且同排），就跳过这段重复的竖线
            const p = parents[0];
            const pp = xy(p);
            const siblings = kidsOf.get(p) ?? [];
            const sameRow = siblings.filter((k) => xy(k).y === c.y);
            if (siblings.length >= 2 && sameRow.length >= 2) continue; // 已由分叉母线画好
            const d = [
              `M${pp.x},${pp.y + NH / 2} L${pp.x},${busY}`,
              Math.abs(pp.x - c.x) > 0.5 ? `M${pp.x},${busY} L${c.x},${busY}` : '',
              `M${c.x},${busY} L${c.x},${c.y - NH / 2}`,
            ]
              .filter(Boolean)
              .join(' ');
            draw(d, litOf([childId, p]));
          }
        }
        for (const node of vis) {
          const g = document.createElementNS(SVGNS, 'g');
          const cls = ['graph-node'];
          if (node.kind === 'course') cls.push('graph-node--course');
          if (node.kind === 'course' && expanded.has(node.course)) cls.push('is-open');
          if (node.planned) cls.push('graph-node--planned');
          if (node.draft) cls.push('graph-node--draft');
          if (current === node.id) cls.push('is-current');
          if (current && !lit.has(node.id)) cls.push('is-dim');
          if (keyword && node.label.toLowerCase().includes(keyword)) cls.push('is-hit');
          g.setAttribute('class', cls.join(' '));
          g.setAttribute('transform', `translate(${node.x},${node.y})`);
          g.dataset.id = node.id;
          // 学科分野：CSS 靠它选色（课程头用分野色系，章节是灰的，只用它区分带）
          if (node.disc) g.setAttribute('data-disc', node.disc);

          const w = nodeW(node);
          const rect = document.createElementNS(SVGNS, 'rect');
          rect.setAttribute('x', String(-w / 2));
          rect.setAttribute('y', String(-NH / 2));
          rect.setAttribute('width', String(w));
          rect.setAttribute('height', String(NH));
          rect.setAttribute('rx', '8');
          g.appendChild(rect);

          const text = document.createElementNS(SVGNS, 'text');
          text.setAttribute('text-anchor', 'middle');
          text.setAttribute('y', '4');
          text.textContent = node.label;
          /* 长标题自动缩字号，别让它冲出节点框 ——
             「向量代数与空间解析几何」这种 11 个字的章名放不进 122px 的框里，
             按 12px 硬排会糊到隔壁节点上（那正是「看着乱」的直接来源）。
             估算宽度时把 ASCII 字符按半个字宽算，中英文混排才不会缩过头。 */
          {
            const visual = [...node.label].reduce((n, ch) => n + (/[\x00-\xff]/.test(ch) ? 0.56 : 1), 0);
            const bold = node.kind === 'course' ? 1.06 : 1;
            const size = Math.min(12, (w - 14) / Math.max(1, visual * bold));
            if (size < 11.6) text.style.fontSize = `${Math.max(8.5, size).toFixed(1)}px`;
          }
          g.appendChild(text);

          if (node.kind !== 'course') {
            // 章号角标：shortTitle() 刻意把「第 N 章」剥掉了（序号由位置表达），
            // 但位置只能看出「在第几层」，看不出「同层里谁先谁后」——
            // 所以把号直接画在节点左侧，学习顺序一眼可读。
            const chip = document.createElementNS(SVGNS, 'rect');
            chip.setAttribute('class', 'graph-node__chip');
            chip.setAttribute('x', String(-w / 2 - CHIP_PAD));
            chip.setAttribute('y', '-9');
            chip.setAttribute('width', '18');
            chip.setAttribute('height', '18');
            chip.setAttribute('rx', '5');
            g.appendChild(chip);

            const num = document.createElementNS(SVGNS, 'text');
            num.setAttribute('class', 'graph-node__num');
            num.setAttribute('text-anchor', 'middle');
            num.setAttribute('x', String(-w / 2 - CHIP_PAD + 9));
            num.setAttribute('y', '4');
            num.textContent = String(node.chapter);
            g.appendChild(num);
          }

          if (node.kind === 'course') {
            const badge = document.createElementNS(SVGNS, 'text');
            badge.setAttribute('class', 'graph-node__badge');
            badge.setAttribute('text-anchor', 'middle');
            badge.setAttribute('y', String(-NH / 2 - 7));
            badge.textContent = node.planned
              ? '预留课程 · 待更新'
              : expanded.has(node.course)
                ? `${node.count} 章 · 点击收起`
                : `${node.count} 章 · 点击展开`;
            g.appendChild(badge);
          }
          nodeLayer.appendChild(g);
        }
      }

      /* ---------------------------------------------------------- 视图
         ⚠️ 这里是最容易把「点击」搞坏的地方，改之前先读这段：
         课程节点在图坐标里的位置是固定的（见 layout），但只要 fit() 重新算
         缩放与平移，它在**屏幕**上就会跳走 —— 用户按原位再点就点空，
         表现就是「打不开也收不起来」。所以：
           · 展开/收起**不重新缩放**，只把横向平移居中一下 —— 屏幕上纵向位置完全不变；
           · **画布高度跟着内容走**（下面的 h = 内容高 + 上下留白）：
             展开一棵大树时画布长高、收起时退回来。这一版之前固定高度，
             结果树的下几层直接顶到画布外面 —— 「越出边界」就是这么来的：
             那不是排版问题，是画布尺寸算错了。
           · 缩放只按**宽度**算：宽度塞得下，高度自然塞得下（因为高度是算出来的）。
         */
      let scale = 1;
      let tx = 0;
      let ty = 0;
      const applyView = () =>
        viewport.setAttribute('transform', `translate(${tx},${ty}) scale(${scale})`);

      const PADDING = 56;
      const MIN_H = 340; // 画布最矮也要这么高，否则两条带会挤成一条缝

      function fit(mode = 'keep') {
        const vis = visibleNodes();
        if (!vis.length) return;
        let minX = Infinity;
        let minY = Infinity;
        let maxX = -Infinity;
        let maxY = -Infinity;
        for (const n of vis) {
          const hw = nodeW(n) / 2;
          minX = Math.min(minX, n.x - hw);
          maxX = Math.max(maxX, n.x + hw);
          minY = Math.min(minY, n.y - NH / 2 - 16);
          maxY = Math.max(maxY, n.y + NH / 2 + 4);
        }
        // 分野带本身就是内容（带标题、带边框），计算范围必须把它一起框进来，
        // 否则「适应窗口」之后带子会被裁掉半截。
        for (const g of groups) {
          minX = Math.min(minX, g.bandLeft);
          maxX = Math.max(maxX, g.bandRight);
          minY = Math.min(minY, g.y0);
          maxY = Math.max(maxY, g.y1);
        }
        // 顶部还要留出「跨列绕行」的通道，别让它顶到画布外面去
        minY = Math.min(minY, TOP_RESERVE - 8);
        const bw = Math.max(1, maxX - minX);
        const bh = Math.max(1, maxY - minY);

        if (mode === 'initial' || mode === 'all') {
          // 按宽度算缩放：初始视图给个上限（太大反而糊），「适应窗口」允许放到更大
          const fitW = (W - PADDING * 2) / bw;
          scale = mode === 'all' ? Math.min(1.4, Math.max(0.3, fitW)) : Math.min(1.15, Math.max(0.3, fitW));
        }
        // 'keep'：缩放不动，只横向居中
        tx = (W - bw * scale) / 2 - minX * scale;

        // 画布高度 = 内容高度 × 缩放 + 上下留白（内容变高就长高，缩起来就退回来）
        const needH = Math.max(MIN_H, Math.ceil(bh * scale) + PADDING * 2);
        if (Math.abs(needH - H) > 0.5) {
          H = needH;
          svg.style.height = `${H}px`;
          svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        }
        ty = PADDING - minY * scale;
        applyView();
      }

      const toLocal = (evt) => {
        const r = svg.getBoundingClientRect();
        return {
          x: ((evt.clientX - r.left) / r.width) * W,
          y: ((evt.clientY - r.top) / r.height) * H,
        };
      };
      const toGraph = (p) => ({ x: (p.x - tx) / scale, y: (p.y - ty) / scale });

      /* ---------------------------------------------------------- 交互 */
      let panning = null;

      /* 节点不可拖动之后，这里只剩「空白处平移」一条路。
         ⚠️ 落在节点上的 pointerdown **不能** preventDefault：
         pointerdown 上一旦 preventDefault，浏览器就不再派发兼容鼠标事件，
         后面的 `click` 会一起消失 —— 点击就彻底点不动了。 */
      svg.addEventListener('pointerdown', (evt) => {
        if (evt.target.closest?.('.graph-node')) return; // 交给 click
        evt.preventDefault();
        panning = { ...toLocal(evt), tx, ty };
        svg.setPointerCapture(evt.pointerId);
        svg.classList.add('is-panning');
      });

      // 兜一层：平移过程中也不许选中文本（CSS 的 user-select 之外再保一道）
      svg.addEventListener('selectstart', (evt) => evt.preventDefault());
      svg.addEventListener('dragstart', (evt) => evt.preventDefault());

      svg.addEventListener('pointermove', (evt) => {
        if (panning) {
          evt.preventDefault();
          const p = toLocal(evt);
          tx = panning.tx + (p.x - panning.x);
          ty = panning.ty + (p.y - panning.y);
          applyView();
          return;
        }
        const g = evt.target.closest?.('.graph-node');
        if (g && byId.has(g.dataset.id)) showTip(byId.get(g.dataset.id), toLocal(evt));
        else hideTip();
      });

      function endPointer(evt) {
        if (panning) {
          panning = null;
          svg.classList.remove('is-panning');
        }
        if (svg.hasPointerCapture?.(evt.pointerId)) svg.releasePointerCapture(evt.pointerId);
      }
      svg.addEventListener('pointerup', endPointer);
      svg.addEventListener('pointercancel', endPointer);
      svg.addEventListener('pointerleave', hideTip);

      /* 单击激活：改用 click，而不是像以前那样在 pointerup 里自己判断。
         以前拖拽要 setPointerCapture，浏览器随后会把 pointerup 重定向到 <svg> 上，
         于是 `evt.target` 不再是那个节点、closest('.graph-node') 恒为 null，
         点击就再也进不了 activate() —— 那就是 bug-9「点了没反应」的真正原因。
         不拖节点之后这套重定向不复存在，直接用 click 反而更短、更稳。 */
      svg.addEventListener('click', (evt) => {
        const g = evt.target.closest?.('.graph-node');
        if (g && byId.has(g.dataset.id)) activate(byId.get(g.dataset.id));
      });

      /** 单击：课程 → 展开/收起；章节 → 选中链条，再点一次才跳 */
      function activate(n) {
        if (n.kind === 'course') {
          if (n.planned) {
            flashTip(n, '这门课的笔记还在安排数量与路线，暂时没有内容可以展开');
            return;
          }
          if (expanded.has(n.course)) {
            expanded.delete(n.course);
          } else {
            // 一次只展开一门：图始终稀疏，位置也稳定。
            for (const cid of [...expanded]) if (cid !== n.course) expanded.delete(cid);
            expanded.add(n.course);
          }
          current = null;
          rebuildLit();
          layout();
          render();
          fit('keep'); // 不重新缩放，课程节点的屏幕位置保持不变
          return;
        }
        if (current === n.id) {
          if (n.href) window.location.href = n.href;
          else flashTip(n, '这篇还是草稿，尚未发布');
          return;
        }
        current = n.id;
        rebuildLit();
        render();
        if (!n.href) flashTip(n, '这篇还是草稿，尚未发布');
      }

      let flashTimer = 0;
      function flashTip(n, extra) {
        clearTimeout(flashTimer);
        showTip(n, null, extra);
        flashTimer = window.setTimeout(hideTip, 2600);
      }

      svg.addEventListener(
        'wheel',
        (evt) => {
          evt.preventDefault();
          const p = toLocal(evt);
          const before = toGraph(p);
          scale = Math.min(3, Math.max(0.3, scale * (evt.deltaY < 0 ? 1.12 : 0.89)));
          const after = toGraph(p);
          tx += (after.x - before.x) * scale;
          ty += (after.y - before.y) * scale;
          applyView();
        },
        { passive: false }
      );

      /* ---------------------------------------------------------- 信息卡 */
      function showTip(n, at, extra) {
        const screen = { x: n.x * scale + tx, y: n.y * scale + ty };
        const box = stage.getBoundingClientRect();
        tip.innerHTML = '';

        const t = document.createElement('p');
        t.className = 'graph-tip__title';
        t.textContent = n.label;
        const m = document.createElement('p');
        m.className = 'graph-tip__meta';
        // 学科分野放在最前面：同名的章（例如「线性表」）在不同学科下不该靠猜
        const disc = discLabel.get(n.disc);
        const prefix = disc ? `${disc} · ` : '';
        if (n.kind === 'course') {
          m.textContent = n.planned
            ? `${prefix}${n.course} · 预留课程`
            : `${prefix}${n.course} · 共 ${n.count} 章${n.live !== n.count ? `（已发布 ${n.live}）` : ''}`;
        } else {
          m.textContent = `${prefix}${n.course} · 第 ${n.chapter} 章${n.draft ? ' · 草稿未发布' : ''}`;
        }
        tip.append(t, m);

        const d = document.createElement('p');
        d.className = 'graph-tip__desc';
        if (extra) d.textContent = extra;
        else if (n.kind === 'course') d.textContent = n.noteText || '点击展开这门课的各章';
        else {
          // 只列真正的章节 —— 课程头是画图的内部结构（入口章挂在它上面），
          // 不是读者意义上的「先修」，以前会把它一并列出来，容易看糊涂。
          // 跨课程的先修带上课程名：短标题「结构体」单看不知道是哪门课的。
          const pre = (prereqOf.get(n.id) ?? [])
            .map((id) => byId.get(id))
            .filter((x) => x && x.kind === 'note')
            .map((x) => (x.course === n.course ? x.label : `${x.label}（${x.course}）`));
          d.textContent = pre.length ? `先修：${pre.join('、')}` : '入门章节，没有先修要求';
        }
        tip.appendChild(d);

        tip.hidden = false;
        const ax = at ? at.x : screen.x;
        const ay = at ? at.y : screen.y;
        const x = Math.min(ax + 14, box.width - tip.offsetWidth - 8);
        const y = Math.min(ay + 18, box.height - tip.offsetHeight - 8);
        tip.style.left = `${Math.max(8, x)}px`;
        tip.style.top = `${Math.max(8, y)}px`;
      }
      function hideTip() {
        tip.hidden = true;
      }

      /* ------------------------------------------------ 适应窗口 / 搜索 */
      document.getElementById('graph-fit')?.addEventListener('click', () => fit('all'));

      let searchTimer = 0;
      searchEl?.addEventListener('input', () => {
        clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => {
          keyword = searchEl.value.trim().toLowerCase();
          render();
        }, 120);
      });

      /* ---------------------------------------------------------- 尺寸 */
      // 只更新几何与坐标，**不改视野** —— 是否 fit 交给调用方决定，
      // 否则窗口一变就把用户当前的缩放/平移冲掉了。
      // 列的位置是响应式的（按画布宽度摊开），所以宽度变了要重排一次节点。
      function resize() {
        const r = svg.getBoundingClientRect();
        W = Math.max(360, r.width);
        // 高度由 fit() 按内容算，这里只保证第一帧有数（viewBox 不能是 0）
        if (!H) H = Math.max(340, Math.round(r.height || 520));
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        layout();
      }

      /* ---------------------------------------------------------- 启动 */
      resize(); // 内部会 layout() 一次
      render();
      fit('initial');

      let rt = 0;
      window.addEventListener('resize', () => {
        clearTimeout(rt);
        rt = window.setTimeout(() => {
          resize();
          render();
          // 宽度变了要重新按宽度定缩放（'keep' 会把上一个小窗口的缩放沿用到新宽度上）
          fit('initial');
        }, 150);
      });
    })();
  </script>
</BaseLayout>

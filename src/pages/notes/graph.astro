---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contentNotes } from '../../utils/notes';
import { courses, courseDeps, draftTitles, shortTitle } from '../../data/curriculum';

/**
 * 知识图谱 /notes/graph/
 * ============================================================
 * 一张**有向**的依赖图：箭头表示「先学 → 后学」。
 *
 * 为什么不做标签关系网：标签是无向的，笔记一多每个节点都会被扯上好几根线，
 * 图会迅速变成一团毛线；而依赖是稀疏的、有向的、有因果的，正好也是读者真正
 * 需要的那条信息 —— 该按什么顺序学。
 *
 * 布局的两条硬约束（踩过的坑，别再动）：
 *   ① **课程节点的位置必须固定**。展开／收起绝不能挪动课程节点本身 ——
 *      否则"点一下展开"之后它就跳走了，用户按原位置再点会点空，
 *      表现就是"打不开也收不起来"。所以课程节点按**序号槽位**定位，
 *      与「展开了几门课」完全无关。
 *   ② 章节固定在**自己课程节点的正下方**一列，只沿纵向排；横向不许乱跑。
 */

const notes = await contentNotes();
const published = new Map(notes.map((n) => [n.id, n]));

const titleOf = (id) => published.get(id)?.data.title ?? draftTitles[id] ?? '';

interface GNode {
  id: string;
  kind: 'course' | 'note';
  label: string;
  course: string;
  count: number;
  live: number;
  planned: boolean;
  noteText: string;
  href?: string;
  draft: boolean;
  rank: number;
  prereq: string[];
}

const nodes: GNode[] = [];
const edges: Array<{ s: string; t: string }> = [];
const courseOfNote = new Map<string, string>();

for (const c of courses) {
  const usable = c.chapters.filter((ch) => titleOf(ch.id));
  for (const ch of usable) courseOfNote.set(ch.id, c.id);

  for (const ch of usable) {
    nodes.push({
      id: ch.id,
      kind: 'note',
      label: shortTitle(titleOf(ch.id), c.id),
      course: c.id,
      count: 0,
      live: 0,
      planned: false,
      noteText: '',
      href: published.has(ch.id) ? `/notes/${ch.id}/` : undefined,
      draft: !published.has(ch.id),
      rank: 0,
      prereq: (ch.prereq ?? []).filter((p) => courseOfNote.has(p) || titleOf(p)),
    });
  }

  nodes.push({
    id: `course:${c.id}`,
    kind: 'course',
    label: c.id,
    course: c.id,
    count: usable.length,
    live: usable.filter((ch) => published.has(ch.id)).length,
    planned: !!c.planned,
    noteText: c.note ?? '',
    draft: false,
    rank: 0,
    prereq: [],
  });
}

const byId = new Map(nodes.map((n) => [n.id, n]));

/**
 * 课内排序：按**依赖深度**（最长前驱链）分层，同层内保持 curriculum.ts 里的书写顺序。
 * 纵向位置因此天然满足「先修在上、后继在下」，不用手写序号。
 */
for (const c of courses) {
  const ids = nodes.filter((n) => n.kind === 'note' && n.course === c.id).map((n) => n.id);
  if (!ids.length) continue;
  const inSet = new Set(ids);
  const depth = new Map();
  const calc = (id, seen = new Set()) => {
    if (depth.has(id)) return depth.get(id);
    if (seen.has(id)) return 0; // 环保护：数据写错也不至于死循环
    seen.add(id);
    const n = byId.get(id);
    const ds = (n?.prereq ?? []).filter((p) => inSet.has(p)).map((p) => calc(p, seen) + 1);
    const d = ds.length ? Math.max(...ds) : 0;
    depth.set(id, d);
    return d;
  };
  for (const id of ids) calc(id);
  const order = new Map(ids.map((id, i) => [id, i]));
  [...ids]
    .sort((a, b) => depth.get(a) - depth.get(b) || order.get(a) - order.get(b))
    .forEach((id, i) => {
      const n = byId.get(id);
      if (n) n.rank = i + 1;
    });
}

/** 课程头 → 本课无课内先修的章；以及章与章之间的先修边 */
for (const c of courses) {
  const hdr = `course:${c.id}`;
  if (!byId.has(hdr)) continue;
  const inCourse = nodes.filter((n) => n.kind === 'note' && n.course === c.id);
  const inIds = new Set(inCourse.map((n) => n.id));
  for (const n of inCourse) {
    const inside = n.prereq.filter((p) => inIds.has(p));
    if (!inside.length) edges.push({ s: hdr, t: n.id });
    for (const p of inside) edges.push({ s: p, t: n.id });
  }
}

/** 课程之间的先修：显式写在 courseDeps 里，箭头 先学 → 后学 */
for (const [after, before] of courseDeps) {
  if (byId.has(`course:${after}`) && byId.has(`course:${before}`)) {
    edges.push({ s: `course:${before}`, t: `course:${after}` });
  }
}

const payload = {
  nodes: nodes.map((n) => ({
    id: n.id,
    kind: n.kind,
    label: n.label,
    course: n.course,
    count: n.count,
    live: n.live,
    planned: n.planned,
    noteText: n.noteText,
    href: n.href,
    draft: n.draft,
    rank: n.rank,
    // 客户端要用它决定「树里谁是父节点」与「哪些边是旁支」——
    // 漏掉这个字段会让脚本在 `.filter` 上直接抛错（踩过一次）
    prereq: n.prereq,
  })),
  edges,
  courses: courses
    .filter((c) => byId.has(`course:${c.id}`))
    .map((c) => {
      const chs = nodes.filter((n) => n.kind === 'note' && n.course === c.id);
      return {
        id: c.id,
        total: chs.length,
        live: chs.filter((n) => !n.draft).length,
        planned: !!c.planned,
      };
    }),
};

const totalChapters = payload.nodes.filter((n) => n.kind === 'note').length;
const plannedCount = payload.courses.filter((c) => c.planned).length;
---

<BaseLayout
  title="知识图谱"
  description={`把 ${notes.length} 篇已发布笔记按「先学 → 后学」的依赖连成一张有向图，点击课程可展开每一章。`}
>
  <div class="wrap">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a>
      <span>/</span>
      <a href="/notes/">笔记</a>
      <span>/</span>
      <span>知识图谱</span>
    </nav>

    <div class="page-head">
      <p class="page-head__kicker">Knowledge Graph</p>
      <h1>知识图谱</h1>
      <p class="page-head__lede">
        箭头方向是<strong>学习的先后顺序</strong>：指着谁，就表示「先学完它，再学这个」。
        点课程节点展开这门课的各章，再点收起；点某一章直接进那篇笔记。
        悬停或点击任一章，会把它<strong>整条先修链</strong>一起点亮。
      </p>
    </div>

    <div class="graph-layout graph-page">
      <aside class="graph-side">
        <div class="graph-side__group">
          <h2>课程</h2>
          <div class="graph-side__list" id="graph-courses"></div>
        </div>

        <div class="graph-side__group">
          <h2>操作</h2>
          <div class="graph-side__list">
            <button type="button" class="graph-btn" id="graph-collapse-all">全部收起</button>
            <button type="button" class="graph-btn" id="graph-expand-all">全部展开</button>
            <button type="button" class="graph-btn" id="graph-tidy">重新排列</button>
            <button type="button" class="graph-btn" id="graph-fit">适应窗口</button>
          </div>
          <p class="graph-side__hint" style="margin-top:0.75rem">
            虚线框 = <strong>预留课程</strong>（笔记还在安排中）或<strong>草稿章节</strong>，点它会提示、不会跳空页面。
            <br />拖动节点可手动摆放，「重新排列」恢复整齐布局。
          </p>
        </div>
      </aside>

      <div class="graph-main">
        <div class="graph-bar">
          <input
            class="graph-search"
            id="graph-search"
            type="search"
            placeholder="搜索章节名，命中会高亮…"
            aria-label="搜索章节"
          />
          <span class="graph-legend">
            <span class="graph-legend__item">
              <svg width="30" height="10" aria-hidden="true">
                <line x1="1" y1="5" x2="21" y2="5" stroke="#d78b34" stroke-width="1.6" />
                <path d="M21 1.6 29 5l-8 3.4z" fill="#d78b34" />
              </svg>
              先学 → 后学
            </span>
          </span>
        </div>

        <div class="graph-stage">
          <svg
            class="graph-canvas"
            id="graph-canvas"
            role="img"
            aria-label={`${totalChapters} 章笔记与 ${payload.courses.length} 门课程按先修关系连成的有向图`}
          >
            <defs>
              <marker
                id="graph-arrow"
                viewBox="0 0 10 10"
                refX="9"
                refY="5"
                markerWidth="6"
                markerHeight="6"
                orient="auto-start-reverse"
              >
                <path d="M0 0 L10 5 L0 10 z" fill="#d9cbb9" />
              </marker>
              <marker
                id="graph-arrow-lit"
                viewBox="0 0 10 10"
                refX="9"
                refY="5"
                markerWidth="6"
                markerHeight="6"
                orient="auto-start-reverse"
              >
                <path d="M0 0 L10 5 L0 10 z" fill="#d78b34" />
              </marker>
            </defs>
            <g id="graph-viewport">
              <g id="graph-links"></g>
              <g id="graph-nodes"></g>
            </g>
          </svg>
          <div class="graph-tip" id="graph-tip" hidden></div>
        </div>

        <p class="graph-note">
          这张图反映的是<strong>教学上的先后依赖</strong>，不是正文里的互相引用——
          顺序来自 <code>src/data/curriculum.ts</code>，想调整先后只改那个文件。
          {plannedCount > 0 && `其中 ${plannedCount} 门是预留课程，笔记还在规划中。`}
        </p>
      </div>
    </div>
  </div>

  <script type="application/json" id="graph-data" set:html={JSON.stringify(payload)} />

  <script>
    (() => {
      const raw = document.getElementById('graph-data')?.textContent;
      if (!raw) return;
      const data = JSON.parse(raw);
      if (!data.nodes?.length) return;

      const svg = document.getElementById('graph-canvas');
      const viewport = document.getElementById('graph-viewport');
      const linkLayer = document.getElementById('graph-links');
      const nodeLayer = document.getElementById('graph-nodes');
      const tip = document.getElementById('graph-tip');
      const stage = svg.parentElement;
      const searchEl = document.getElementById('graph-search');
      const SVGNS = 'http://www.w3.org/2000/svg';

      /* 节点尺寸：统一固定，矩形重叠判定才可靠 */
      const NH = 30; // 节点高
      const HEAD_W = 132; // 课程节点宽
      const CH_W = 122; // 章节节点宽
      const ROW = 52; // 层级纵向步距
      const HEAD_Y = 44; // 所有课程头都在这一行
      const CH_TOP = HEAD_Y + 54; // 章节起始 y
      const MIN_COL = 172; // 列最小间距
      const SLOT = 148; // 树里相邻叶子的横向步距

      let W = 900;
      let H = 640;

      const nodes = data.nodes.map((n) => ({
        ...n,
        x: 0,
        y: 0,
        homeX: 0,
        homeY: 0,
        dragged: false,
      }));
      const byId = new Map(nodes.map((n) => [n.id, n]));
      const courseIds = data.courses.map((c) => c.id);
      const plannedSet = new Set(data.courses.filter((c) => c.planned).map((c) => c.id));

      /* 展开状态：默认展开章最多的那门（一次看一门，图才稀疏） */
      const expandable = data.courses.filter((c) => !c.planned && c.total > 0);
      const biggest = [...expandable].sort((a, b) => b.total - a.total)[0];
      const expanded = new Set(biggest ? [biggest.id] : []);

      const isVisible = (n) => n.kind === 'course' || expanded.has(n.course);
      const visibleNodes = () => nodes.filter(isVisible);
      const nodeW = (n) => (n.kind === 'course' ? HEAD_W : CH_W);

      /** 课程间箭头的横向车道 y（每条 +16，互不重叠） */
      let COURSE_LANE_Y = 0;
      let courseLaneSeq = 0;

      /* ---------------------------------------------------------- 定位
         ⚠️ 两条硬约束，改之前先读：
         ① **课程节点位置固定**：按序号槽位定位（`colAt(slot)`），与展开状态无关。
            否则"点一下展开"之后它就跳走，用户按原位再点会点空 —— 这就是 bug-9。
         ② **课程内按树排列，不按一条竖列排**。竖列会让"跳过中间节点的边"
            （如 函数 → 结构体）直接从 数组/指针 的方块里穿过去，读图会被误导。
            所以：按父子关系把章节摆成树 —— 叶子从左到右占槽位、父节点居于子树中间。
         `fit('keep')` 时只做横向居中，纵向与缩放不动，屏幕位置因此全程稳定。 */
      function layout() {
        const n = Math.max(1, courseIds.length);
        W = Math.max(W, n * MIN_COL); // 列多就把逻辑画布撑宽
        const colAt = (i) => (W * (i + 1)) / (n + 1);
        const bandW = W / n;
        const vis = visibleNodes();

        for (const cid of courseIds) {
          const slot = courseIds.indexOf(cid);
          const cx = colAt(slot);
          const head = byId.get(`course:${cid}`);
          if (head) {
            head.homeX = cx;
            head.homeY = HEAD_Y;
          }
          const chapters = vis.filter((x) => x.kind === 'note' && x.course === cid);
          if (!chapters.length) continue;

          const ids = new Set(chapters.map((c) => c.id));
          const map = new Map(chapters.map((c) => [c.id, c]));

          // 父子关系：取「排序最靠前的那个课内先修」当主父节点；
          // 无课内先修的挂在课程头上。其余先修仍会画成虚线边（见 render）。
          const kids = new Map();
          const depth = new Map();
          for (const c of chapters) {
            const ins = c.prereq.filter((p) => ids.has(p));
            const parent = ins.length ? map.get(ins[0]) : head;
            const key = parent ? parent.id : '__root__';
            if (!kids.has(key)) kids.set(key, []);
            kids.get(key).push(c);
          }
          for (const list of kids.values()) list.sort((a, b) => a.rank - b.rank);

          // 叶子从左到右占槽位，父节点落在子树跨度中点
          const leaf = new Map();
          let k = 0;
          const place = (node) => {
            const ch = kids.get(node.id) ?? [];
            if (!ch.length) {
              const pos = k++;
              leaf.set(node.id, { min: pos, max: pos, pos });
              return leaf.get(node.id);
            }
            const spans = ch.map(place);
            const span = {
              min: Math.min(...spans.map((s) => s.min)),
              max: Math.max(...spans.map((s) => s.max)),
              pos: 0,
            };
            span.pos = (span.min + span.max) / 2;
            leaf.set(node.id, span);
            return span;
          };

          const roots = (kids.get('__root__') ?? []).slice().sort((a, b) => a.rank - b.rank);
          const rootSpans = roots.map(place);
          const total =
            rootSpans.length > 1
              ? Math.max(...rootSpans.map((s) => s.max)) - Math.min(...rootSpans.map((s) => s.min))
              : 0;

          // 槽位步距：能放下就居中，放不下就压到 bandW 内
          const step = total > 0 ? Math.min(SLOT, (bandW - 40) / total) : 0;
          const span = total * step;
          const baseX = cx - span / 2;

          for (const c of chapters) {
            const sp = leaf.get(c.id);
            c.homeX = total > 0 ? baseX + sp.pos * step : cx;
          }

          // 纵向按「从根到该节点的最长路径」分层，保证先修一定在上面
          const depthOf = (node, seen = new Set()) => {
            if (depth.has(node.id)) return depth.get(node.id);
            if (seen.has(node.id)) return 0;
            seen.add(node.id);
            const ins = (map.get(node.id)?.prereq ?? []).filter((p) => ids.has(p));
            const d = ins.length ? Math.max(...ins.map((p) => depthOf(map.get(p), seen))) + 1 : 1;
            depth.set(node.id, d);
            return d;
          };
          for (const c of chapters) depthOf(c);
          for (const c of chapters) c.homeY = CH_TOP + (depth.get(c.id) - 1) * ROW;
        }

        // 应用（被拖过的节点保持用户摆的位置）
        for (const node of vis) if (!node.dragged) {
          node.x = node.homeX;
          node.y = node.homeY;
        }

        // 课程之间的箭头走**自己的通道**：绕到所有内容下方，
        // 再各自用一条横向车道升上去接目标课程。这样它们不会从别的课程节点上压过去。
        const deepest = Math.max(
          HEAD_Y,
          ...vis.filter((x) => x.kind === 'note').map((x) => x.y)
        );
        COURSE_LANE_Y = deepest + 46;
      }

      /** 兜底：同一层里若有重叠，只沿纵向错开一点 */
      function separate() {
        const vis = visibleNodes();
        const byRow = new Map();
        for (const n of vis) {
          const key = `${n.course}|${Math.round(n.y)}`;
          if (!byRow.has(key)) byRow.set(key, []);
          byRow.get(key).push(n);
        }
        for (const list of byRow.values()) {
          list.sort((a, b) => a.x - b.x);
          for (let i = 1; i < list.length; i++) {
            const a = list[i - 1];
            const b = list[i];
            const need = (nodeW(a) + nodeW(b)) / 2 + 10;
            if (b.x - a.x < need) b.x = a.x + need;
          }
        }
      }

      function relayout({ keepDragged = true } = {}) {
        if (!keepDragged) for (const n of nodes) n.dragged = false;
        layout();
        separate();
      }

      /* ---------------------------------------------------------- 选中 / 搜索 */
      const lit = new Set();
      let current = null;
      let keyword = '';

      // 边：收起课程里的源节点上移到该课的课程节点，跨课依赖才画得出来。
      // 一个章节有多个课内先修时，只有「主父节点」（layout 里用的那个）画实线，
      // 其余画虚线 —— 否则树会被额外连线搞乱，读者也分不清哪条是主干。
      const primaryParent = new Map();
      for (const node of nodes) {
        if (node.kind !== 'note') continue;
        const inCourse = nodes.filter(
          (x) => x.kind === 'note' && x.course === node.course
        );
        const ids = new Set(inCourse.map((x) => x.id));
        const ins = node.prereq.filter((p) => ids.has(p));
        primaryParent.set(node.id, ins.length ? ins[0] : `course:${node.course}`);
      }

      const edges = data.edges
        .map((e) => {
          const s = byId.get(e.s);
          const t = byId.get(e.t);
          if (!s || !t) return null;
          const cross = s.course !== t.course;
          const src =
            s.kind === 'note' && cross && !expanded.has(s.course)
              ? byId.get(`course:${s.course}`)
              : s;
          const primary =
            t.kind === 'note' &&
            primaryParent.get(t.id) &&
            primaryParent.get(t.id) === s.id;
          return { s: src, t, cross, primary: cross || primary };
        })
        .filter((e) => e && e.s && e.t && e.s !== e.t);

      const prereqOf = new Map();
      const nextOf = new Map();
      for (const e of edges) {
        if (!prereqOf.has(e.t.id)) prereqOf.set(e.t.id, []);
        prereqOf.get(e.t.id).push(e.s.id);
        if (!nextOf.has(e.s.id)) nextOf.set(e.s.id, []);
        nextOf.get(e.s.id).push(e.t.id);
      }

      function rebuildLit() {
        lit.clear();
        if (!current) return;
        lit.add(current);
        const up = [current];
        while (up.length) {
          for (const p of prereqOf.get(up.pop()) ?? []) {
            if (!lit.has(p) && byId.has(p)) {
              lit.add(p);
              up.push(p);
            }
          }
        }
        const down = [current];
        while (down.length) {
          for (const nx of nextOf.get(down.pop()) ?? []) {
            if (!lit.has(nx) && byId.has(nx)) {
              lit.add(nx);
              down.push(nx);
            }
          }
        }
      }

      /* ---------------------------------------------------------- 渲染 */
      function render() {
        const vis = visibleNodes();
        linkLayer.replaceChildren();
        nodeLayer.replaceChildren();
        courseLaneSeq = 0; // 每次重画都从第一条车道开始，避免越画越靠下

        for (const e of edges) {
          if (!isVisible(e.s) || !isVisible(e.t)) continue;
          const isLit = current && lit.has(e.s.id) && lit.has(e.t.id);
          const path = document.createElementNS(SVGNS, 'path');

          if (e.cross && e.s.kind === 'course' && e.t.kind === 'course') {
            // 课程 → 课程：走下方专属车道（见 layout 里的 COURSE_LANE_Y）。
            // 起点从**本课程头下沿**出发、终点接**目标课程头下沿**，箭头朝上进入 ——
            // 这样横向段完全在所有课程节点之下，不会从中间的课程节点上压过去。
            const lane = COURSE_LANE_Y + courseLaneSeq++ * 16;
            const x1 = e.s.x;
            const y1 = e.s.y + NH / 2;
            const x2 = e.t.x;
            const y2 = e.t.y + NH / 2 + 7;
            path.setAttribute('d', `M${x1},${y1} C${x1},${lane} ${x2},${lane} ${x2},${y2}`);
            path.setAttribute('marker-end', isLit ? 'url(#graph-arrow-lit)' : 'url(#graph-arrow)');
          } else {
            const x1 = e.s.x;
            const y1 = e.s.y + NH / 2;
            const x2 = e.t.x;
            const y2 = e.t.y - NH / 2;
            const dx = x2 - x1;
            const bend = Math.abs(dx) < 8 ? 0 : Math.max(-52, Math.min(52, dx * 0.24));
            path.setAttribute(
              'd',
              bend === 0
                ? `M${x1},${y1} L${x2},${y2}`
                : `M${x1},${y1} Q${x1 + bend},${(y1 + y2) / 2} ${x2},${y2}`
            );
          }
          path.setAttribute('fill', 'none');
          path.setAttribute(
            'class',
            'graph-link' +
              (e.primary ? '' : ' graph-link--secondary') +
              (isLit ? ' is-lit' : current ? ' is-dim' : '')
          );
          path.setAttribute('marker-end', isLit ? 'url(#graph-arrow-lit)' : 'url(#graph-arrow)');
          linkLayer.appendChild(path);
        }

        for (const node of vis) {
          const g = document.createElementNS(SVGNS, 'g');
          const cls = ['graph-node'];
          if (node.kind === 'course') cls.push('graph-node--course');
          if (node.planned) cls.push('graph-node--planned');
          if (node.draft) cls.push('graph-node--draft');
          if (current === node.id) cls.push('is-current');
          if (current && !lit.has(node.id)) cls.push('is-dim');
          if (keyword && node.label.toLowerCase().includes(keyword)) cls.push('is-hit');
          g.setAttribute('class', cls.join(' '));
          g.setAttribute('transform', `translate(${node.x},${node.y})`);
          g.dataset.id = node.id;

          const w = nodeW(node);
          const rect = document.createElementNS(SVGNS, 'rect');
          rect.setAttribute('x', String(-w / 2));
          rect.setAttribute('y', String(-NH / 2));
          rect.setAttribute('width', String(w));
          rect.setAttribute('height', String(NH));
          rect.setAttribute('rx', '8');
          g.appendChild(rect);

          const text = document.createElementNS(SVGNS, 'text');
          text.setAttribute('text-anchor', 'middle');
          text.setAttribute('y', '4');
          text.textContent = node.label;
          g.appendChild(text);

          if (node.kind === 'course') {
            const badge = document.createElementNS(SVGNS, 'text');
            badge.setAttribute('class', 'graph-node__badge');
            badge.setAttribute('text-anchor', 'middle');
            badge.setAttribute('y', String(-NH / 2 - 7));
            badge.textContent = node.planned
              ? '预留课程 · 待更新'
              : expanded.has(node.course)
                ? `${node.count} 章 · 点击收起`
                : `${node.count} 章 · 点击展开`;
            g.appendChild(badge);
          }
          nodeLayer.appendChild(g);
        }
      }

      /* ---------------------------------------------------------- 视图
         ⚠️ 这里是最容易把「点击」搞坏的地方，改之前先读这段：
         课程节点在图坐标里的位置是固定的（见 layout），但只要 fit() 重新算
         缩放与平移，它在**屏幕**上就会跳走 —— 用户按原位再点就点空，
         表现就是「打不开也收不起来」。所以：
           · fit(mode:'initial') 只在首次进入与手动点「适应窗口」时用，锚定顶部；
           · 展开/收起**不重新 fit**，只把横向平移居中一下，纵向与缩放保持不动。
         */
      let scale = 1;
      let tx = 0;
      let ty = 0;
      const applyView = () =>
        viewport.setAttribute('transform', `translate(${tx},${ty}) scale(${scale})`);

      const PADDING = 56;

      function fit(mode = 'keep') {
        const vis = visibleNodes();
        if (!vis.length) return;
        let minX = Infinity;
        let minY = Infinity;
        let maxX = -Infinity;
        let maxY = -Infinity;
        for (const n of vis) {
          const hw = nodeW(n) / 2;
          minX = Math.min(minX, n.x - hw);
          maxX = Math.max(maxX, n.x + hw);
          minY = Math.min(minY, n.y - NH / 2 - 16);
          maxY = Math.max(maxY, n.y + NH / 2 + 4);
        }
        const w = Math.max(1, maxX - minX);

        if (mode === 'initial') {
          // 初始视野：优先保证左右别压线，但缩到一定限度就不再缩（再小就看不清也点不准）。
          // 纵向**锚定顶部**——内容是往下长的，居中会把下面的空间挤没。
          const bw = Math.max(1, maxX - minX);
          scale = Math.min(1.3, Math.max(0.58, (W - PADDING * 2) / bw));
          tx = (W - bw * scale) / 2 - minX * scale;
        } else {
          // 保持缩放与纵向位置不变，只把横向居中 —— 屏幕上的纵向位置因此完全不动
          const bw = Math.max(1, maxX - minX);
          tx = (W - bw * scale) / 2 - minX * scale;
        }
        // 顶部对齐：所有课程头都在同一行，锚住它，展开时下面的内容才有地方长
        ty = PADDING - minY * scale;
        applyView();
      }

      const toLocal = (evt) => {
        const r = svg.getBoundingClientRect();
        return {
          x: ((evt.clientX - r.left) / r.width) * W,
          y: ((evt.clientY - r.top) / r.height) * H,
        };
      };
      const toGraph = (p) => ({ x: (p.x - tx) / scale, y: (p.y - ty) / scale });

      /* ---------------------------------------------------------- 交互 */
      let dragging = null;
      let panning = null;

      svg.addEventListener('pointerdown', (evt) => {
        const g = evt.target.closest?.('.graph-node');
        if (g && byId.has(g.dataset.id)) {
          dragging = { node: byId.get(g.dataset.id), moved: 0 };
          svg.setPointerCapture(evt.pointerId);
          svg.classList.add('is-dragging');
          return;
        }
        panning = { ...toLocal(evt), tx, ty };
        svg.setPointerCapture(evt.pointerId);
        svg.classList.add('is-panning');
      });

      svg.addEventListener('pointermove', (evt) => {
        if (dragging) {
          const p = toGraph(toLocal(evt));
          const n = dragging.node;
          dragging.moved += Math.hypot(p.x - n.x, p.y - n.y);
          // 课程节点不许拖走：位置稳定是"点得中"的前提（只有章节能手动摆）
          if (n.kind !== 'course') {
            n.x = p.x;
            n.y = p.y;
            n.dragged = true;
          }
          render();
          return;
        }
        if (panning) {
          const p = toLocal(evt);
          tx = panning.tx + (p.x - panning.x);
          ty = panning.ty + (p.y - panning.y);
          applyView();
          return;
        }
        const g = evt.target.closest?.('.graph-node');
        if (g && byId.has(g.dataset.id)) showTip(byId.get(g.dataset.id), toLocal(evt));
        else hideTip();
      });

      function endPointer(evt) {
        if (dragging) {
          const g = evt.target.closest?.('.graph-node');
          // 位移很小才算点击；拖动过就不触发，免得想挪一下却被展开
          if (dragging.moved < 5 && g?.dataset.id === dragging.node.id) {
            activate(dragging.node);
          }
          dragging = null;
          svg.classList.remove('is-dragging');
        }
        if (panning) {
          panning = null;
          svg.classList.remove('is-panning');
        }
        if (svg.hasPointerCapture?.(evt.pointerId)) svg.releasePointerCapture(evt.pointerId);
      }
      svg.addEventListener('pointerup', endPointer);
      svg.addEventListener('pointercancel', endPointer);
      svg.addEventListener('pointerleave', hideTip);

      /** 单击：课程 → 展开/收起；章节 → 选中链条，再点一次才跳 */
      function activate(n) {
        if (n.kind === 'course') {
          if (n.planned) {
            flashTip(n, '这门课的笔记还在安排数量与路线，暂时没有内容可以展开');
            return;
          }
          if (expanded.has(n.course)) {
            expanded.delete(n.course);
          } else {
            // 一次只展开一门：先把别的收起来。图始终稀疏，位置也稳定。
            for (const cid of [...expanded]) if (cid !== n.course) expanded.delete(cid);
            for (const x of nodes) if (x.course !== n.course) x.dragged = false;
            expanded.add(n.course);
          }
          current = null;
          rebuildLit();
          syncSidebar();
          relayout({ keepDragged: true });
          render();
          fit('keep'); // 不重新缩放，课程节点的屏幕位置保持不变
          return;
        }
        if (current === n.id) {
          if (n.href) window.location.href = n.href;
          else flashTip(n, '这篇还是草稿，尚未发布');
          return;
        }
        current = n.id;
        rebuildLit();
        render();
        if (!n.href) flashTip(n, '这篇还是草稿，尚未发布');
      }

      let flashTimer = 0;
      function flashTip(n, extra) {
        clearTimeout(flashTimer);
        showTip(n, null, extra);
        flashTimer = window.setTimeout(() => {
          if (!dragging) hideTip();
        }, 2600);
      }

      svg.addEventListener(
        'wheel',
        (evt) => {
          evt.preventDefault();
          const p = toLocal(evt);
          const before = toGraph(p);
          scale = Math.min(3, Math.max(0.3, scale * (evt.deltaY < 0 ? 1.12 : 0.89)));
          const after = toGraph(p);
          tx += (after.x - before.x) * scale;
          ty += (after.y - before.y) * scale;
          applyView();
        },
        { passive: false }
      );

      /* ---------------------------------------------------------- 信息卡 */
      function showTip(n, at, extra) {
        const screen = { x: n.x * scale + tx, y: n.y * scale + ty };
        const box = stage.getBoundingClientRect();
        tip.innerHTML = '';

        const t = document.createElement('p');
        t.className = 'graph-tip__title';
        t.textContent = n.label;
        const m = document.createElement('p');
        m.className = 'graph-tip__meta';
        if (n.kind === 'course') {
          m.textContent = n.planned
            ? `${n.course} · 预留课程`
            : `${n.course} · 共 ${n.count} 章${n.live !== n.count ? `（已发布 ${n.live}）` : ''}`;
        } else {
          m.textContent = `${n.course} · 第 ${n.rank} 章${n.draft ? ' · 草稿未发布' : ''}`;
        }
        tip.append(t, m);

        const d = document.createElement('p');
        d.className = 'graph-tip__desc';
        if (extra) d.textContent = extra;
        else if (n.kind === 'course') d.textContent = n.noteText || '点击展开这门课的各章';
        else {
          const pre = (prereqOf.get(n.id) ?? []).map((id) => byId.get(id)?.label).filter(Boolean);
          d.textContent = pre.length ? `先修：${pre.join('、')}` : '入门章节，没有先修要求';
        }
        tip.appendChild(d);

        tip.hidden = false;
        const ax = at ? at.x : screen.x;
        const ay = at ? at.y : screen.y;
        const x = Math.min(ax + 14, box.width - tip.offsetWidth - 8);
        const y = Math.min(ay + 18, box.height - tip.offsetHeight - 8);
        tip.style.left = `${Math.max(8, x)}px`;
        tip.style.top = `${Math.max(8, y)}px`;
      }
      function hideTip() {
        tip.hidden = true;
      }

      /* ---------------------------------------------------------- 侧栏 */
      function courseColor(id) {
        const palette = ['#d78b34', '#4f9a76', '#c9402e', '#7a6bb5', '#3f8fb0', '#c2486f'];
        const i = courseIds.indexOf(id);
        return palette[(i < 0 ? 0 : i) % palette.length];
      }

      function syncSidebar() {
        const host = document.getElementById('graph-courses');
        if (!host) return;
        host.replaceChildren();
        for (const c of data.courses) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'graph-side__item' + (expanded.has(c.id) ? ' is-active' : '');
          btn.dataset.course = c.id;
          btn.disabled = !!c.planned;
          const dot = document.createElement('span');
          dot.className = 'graph-side__dot';
          dot.style.background = courseColor(c.id);
          const name = document.createElement('span');
          name.textContent = c.id;
          const count = document.createElement('span');
          count.className = 'graph-side__count';
          count.textContent = c.planned ? '待更新' : String(c.total);
          btn.append(dot, name, count);
          host.appendChild(btn);
        }
      }

      /** 切换某门课的展开状态：一次只留一门 */
      function toggleCourse(id) {
        if (plannedSet.has(id)) return;
        if (expanded.has(id)) {
          expanded.delete(id);
        } else {
          for (const cid of [...expanded]) if (cid !== id) expanded.delete(cid);
          for (const x of nodes) if (x.course !== id) x.dragged = false;
          expanded.add(id);
        }
        current = null;
        rebuildLit();
        syncSidebar();
        relayout({ keepDragged: true });
        render();
        fit('keep');
      }

      document.getElementById('graph-courses')?.addEventListener('click', (evt) => {
        const btn = evt.target.closest?.('[data-course]');
        if (!btn || btn.disabled) return;
        toggleCourse(btn.dataset.course);
      });

      document.getElementById('graph-collapse-all')?.addEventListener('click', () => {
        expanded.clear();
        current = null;
        rebuildLit();
        syncSidebar();
        relayout({ keepDragged: false });
        render();
        fit('keep');
      });

      document.getElementById('graph-expand-all')?.addEventListener('click', () => {
        for (const c of expandable) expanded.add(c.id);
        current = null;
        rebuildLit();
        syncSidebar();
        relayout({ keepDragged: true });
        render();
        fit('keep');
      });

      document.getElementById('graph-tidy')?.addEventListener('click', () => {
        relayout({ keepDragged: false });
        render();
        fit('keep');
      });

      document.getElementById('graph-fit')?.addEventListener('click', () => fit('initial'));

      let searchTimer = 0;
      searchEl?.addEventListener('input', () => {
        clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => {
          keyword = searchEl.value.trim().toLowerCase();
          render();
        }, 120);
      });

      /* ---------------------------------------------------------- 尺寸 */
      // 只更新几何与坐标，**不改视野** —— 是否 fit 交给调用方决定，
      // 否则窗口一变就把用户当前的缩放/平移冲掉了。
      function resize() {
        const r = svg.getBoundingClientRect();
        W = Math.max(360, r.width);
        H = Math.max(300, r.height);
        svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
        relayout({ keepDragged: true });
      }

      /* ---------------------------------------------------------- 启动 */
      resize();
      syncSidebar();
      render();
      fit('initial');

      let rt = 0;
      window.addEventListener('resize', () => {
        clearTimeout(rt);
        rt = window.setTimeout(() => {
          resize();
          render();
          fit('keep');
        }, 150);
      });
    })();
  </script>
</BaseLayout>

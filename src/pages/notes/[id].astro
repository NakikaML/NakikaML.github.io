---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import DevNoteEditor from '../../components/DevNoteEditor.astro';
import {
  allNotes,
  siblings,
  relatedNotes,
  fmtDate,
  noteHref,
} from '../../utils/notes';
import { buildToc, chapterOf, countToc } from '../../utils/toc';

export async function getStaticPaths() {
  const notes = await allNotes();
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note, siblingsPair: siblings(notes, note), related: relatedNotes(notes, note, 4) },
  }));
}

const { note, siblingsPair, related } = Astro.props;
const { Content, headings } = await render(note);

const d = note.data;
const isMap = d.kind === 'moc';

// 类论文的层级目录：h2 → 1.1，h3 → 1.1.1，h4 是知识点（只罗列、不编号）。
// 编号规则与树形结构见 src/utils/toc.ts；章号从标题里取（"…-2 线性表" → 2）。
const toc = buildToc(headings, chapterOf(d.title));
const tocCount = countToc(toc);

const date = fmtDate(d.date);
---

<BaseLayout title={d.title} description={`${d.category} · ${d.title}`} ogType="article">
  <div class="wrap wrap--read">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a>
      <span>/</span>
      <a href={isMap ? '/maps/' : '/notes/'}>{isMap ? '知识地图' : '笔记'}</a>
      <span>/</span>
      <a href={`/notes/?cat=${encodeURIComponent(d.category)}`}>{d.category}</a>
    </nav>

    <header class="note-head">
      <h1>{d.title}</h1>
      <div class="note-head__meta">
        <span class="tag tag--accent">{d.category}</span>
        {d.difficulty && <span>{d.difficulty}</span>}
        {d.subfield && <span>{d.subfield}</span>}
        {date && <time datetime={date}>{date}</time>}
      </div>
      {
        d.tags.length > 0 && (
          <div class="tag-row" style="margin-top:0.85rem">
            {d.tags.map((t) => (
              <a class="tag" href={`/notes/?tag=${encodeURIComponent(t)}`}>
                #{t}
              </a>
            ))}
          </div>
        )
      }
    </header>

    {
      tocCount > 2 && (
        <nav class="toc" aria-label="目录">
          <div class="toc__title">本页目录</div>
          <ul class="toc__list">
            {toc.map((node) => (
              <li class="toc__item toc__item--h2">
                {node.slug && (
                  <a href={`#${node.slug}`}>
                    {node.number && <span class="toc__num">{node.number}</span>}
                    <span>{node.text}</span>
                  </a>
                )}
                {node.children.length > 0 && (
                  <ul class="toc__list">
                    {node.children.map((sub) => (
                      <li class="toc__item toc__item--h3">
                        {sub.slug && (
                          <a href={`#${sub.slug}`}>
                            <span class="toc__num">{sub.number}</span>
                            <span>{sub.text}</span>
                          </a>
                        )}
                        {/* 第三层：知识点，只罗列、不编号 */}
                        {sub.children.length > 0 && (
                          <p class="toc__points">
                            {sub.children.map((leaf, i) => (
                              <>
                                {i > 0 && <span class="toc__sep">·</span>}
                                <a href={`#${leaf.slug}`}>{leaf.text}</a>
                              </>
                            ))}
                          </p>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <article class="prose">
      <Content />
    </article>

    {
      d.url && (
        <div class="notice">
          本文是对外部内容的学习笔记，原文出处：
          <a href={d.url} target="_blank" rel="noopener">
            {d.url}
          </a>
        </div>
      )
    }

    {
      related.length > 0 && (
        <section style="margin-top:3.5rem">
          <h2 style="font-size:1.1rem;border:0;padding:0;margin-bottom:1rem">相关笔记</h2>
          <div class="grid">
            {related.map((r) => (
              <NoteCard note={r} />
            ))}
          </div>
        </section>
      )
    }

    {
      (siblingsPair?.prev || siblingsPair?.next) && (
        <nav class="prev-next" aria-label="同分类上下篇">
          {siblingsPair?.prev ? (
            <a href={noteHref(siblingsPair.prev)}>
              <span class="prev-next__label">← 上一篇</span>
              <span>{siblingsPair.prev.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {siblingsPair?.next ? (
            <a class="prev-next__next" href={noteHref(siblingsPair.next)}>
              <span class="prev-next__label">下一篇 →</span>
              <span>{siblingsPair.next.data.title}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }

    {/* 本地开发专用：页面上直接改字 / 改原文。生产构建时 DEV 为 false，不输出任何东西 */}
    {import.meta.env.DEV && <DevNoteEditor collection="notes" id={note.id} />}
  </div>
</BaseLayout>

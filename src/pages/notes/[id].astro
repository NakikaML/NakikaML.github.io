---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import {
  allNotes,
  siblings,
  relatedNotes,
  fmtDate,
  noteHref,
} from '../../utils/notes';
import { buildToc, chapterOf, countToc } from '../../utils/toc';

export async function getStaticPaths() {
  const notes = await allNotes();
  return notes.map((note) => ({
    params: { id: note.id },
    props: { note, siblingsPair: siblings(notes, note), related: relatedNotes(notes, note, 4) },
  }));
}

const { note, siblingsPair, related } = Astro.props;
const { Content, headings } = await render(note);

const d = note.data;
const isMap = d.kind === 'moc';

// 类论文的层级目录：h2 → 1.1，h3 → 1.1.1，h4 是知识点（只罗列、不编号）。
// 编号规则与树形结构见 src/utils/toc.ts；章号从标题里取（"…-2 线性表" → 2）。
const toc = buildToc(headings, chapterOf(d.title));
const tocCount = countToc(toc);
// 目录够长才值得单独占一栏（很短的目录摆到左边反而比正文还抢眼）
const hasToc = tocCount > 2;

const date = fmtDate(d.date);
---

<BaseLayout title={d.title} description={`${d.category} · ${d.title}`} ogType="article">
  <div class="wrap wrap--note">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a>
      <span>/</span>
      <a href={isMap ? '/maps/' : '/notes/'}>{isMap ? '知识地图' : '笔记'}</a>
      <span>/</span>
      <a href={`/notes/?cat=${encodeURIComponent(d.category)}`}>{d.category}</a>
    </nav>

    <header class="note-head">
      <h1>{d.title}</h1>
      <div class="note-head__meta">
        <span class="tag tag--accent">{d.category}</span>
        {d.difficulty && <span>{d.difficulty}</span>}
        {d.subfield && <span>{d.subfield}</span>}
        {date && <time datetime={date}>{date}</time>}
        {/* 原文 .md 由 src/pages/notes/[id].md.ts 在构建时一并产出（opinion-1） */}
        <a class="note-download" href={`/notes/${note.id}.md`} download={`${note.id}.md`}>
          下载原文 .md
        </a>
      </div>
      {
        d.tags.length > 0 && (
          <div class="tag-row" style="margin-top:0.85rem">
            {d.tags.map((t) => (
              <a class="tag" href={`/notes/?tag=${encodeURIComponent(t)}`}>
                #{t}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class={`note-layout${hasToc ? ' note-layout--aside' : ''}`}>
      {
        hasToc && (
          <nav class="toc" aria-label="目录">
            <div class="toc__title">本页目录</div>
            <ul class="toc__list">
              {toc.map((node) => (
                <li class="toc__item toc__item--h2">
                  {node.slug && (
                    <a href={`#${node.slug}`}>
                      {node.number && <span class="toc__num">{node.number}</span>}
                      <span>{node.text}</span>
                    </a>
                  )}
                  {node.children.length > 0 && (
                    <ul class="toc__list">
                      {node.children.map((sub) => (
                        <li class="toc__item toc__item--h3">
                          {sub.slug && (
                            <a href={`#${sub.slug}`}>
                              <span class="toc__num">{sub.number}</span>
                              <span>{sub.text}</span>
                            </a>
                          )}
                          {/* 第三层：知识点，只罗列、不编号，一行一个 */}
                          {sub.children.length > 0 && (
                            <ul class="toc__points">
                              {sub.children.map((leaf) => (
                                <li>
                                  <a href={`#${leaf.slug}`}>{leaf.text}</a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <div class="note-body">
        <article class="prose">
          <Content />
        </article>

        {
          d.url && (
            <div class="notice">
              本文是对外部内容的学习笔记，原文出处：
              <a href={d.url} target="_blank" rel="noopener">
                {d.url}
              </a>
            </div>
          )
        }

        {
          related.length > 0 && (
            <section style="margin-top:3.5rem">
              <h2 style="font-size:1.1rem;border:0;padding:0;margin-bottom:1rem">相关笔记</h2>
              <div class="grid">
                {related.map((r) => (
                  <NoteCard note={r} />
                ))}
              </div>
            </section>
          )
        }

        {
          (siblingsPair?.prev || siblingsPair?.next) && (
            <nav class="prev-next" aria-label="同分类上下篇">
              {siblingsPair?.prev ? (
                <a href={noteHref(siblingsPair.prev)}>
                  <span class="prev-next__label">← 上一篇</span>
                  <span>{siblingsPair.prev.data.title}</span>
                </a>
              ) : (
                <span />
              )}
              {siblingsPair?.next ? (
                <a class="prev-next__next" href={noteHref(siblingsPair.next)}>
                  <span class="prev-next__label">下一篇 →</span>
                  <span>{siblingsPair.next.data.title}</span>
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }
      </div>
    </div>
  </div>

  <script>
    // 目录联动（opinion-5）：滚到哪一节，就把左侧目录里的哪一条点亮。
    // 只跟 h2/h3 这些编号条目 —— 三层知识点在目录里是挤成一行的小字，
    // 逐个高亮会一直乱闪，反而看不清自己在哪。
    const tocEl = document.querySelector<HTMLElement>('.toc');
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.toc .toc__item > a[href^="#"]')
    );

    if (tocEl && links.length > 0) {
      const entries = links
        .map((link) => {
          // href 里可能是中文 id，浏览器取回来也许是百分号编码，两种都试
          const raw = (link.getAttribute('href') ?? '').slice(1);
          let el = document.getElementById(raw);
          if (!el) {
            try {
              el = document.getElementById(decodeURIComponent(raw));
            } catch {
              /* 非法转义序列，按原样找不到就算了 */
            }
          }
          return el ? { link, el } : null;
        })
        .filter((x): x is { link: HTMLAnchorElement; el: HTMLElement } => x !== null);

      // 顶栏是 sticky 的（4rem），基准线要压在它下面；与 CSS 的 scroll-margin-top 对齐
      const OFFSET = 88;
      let currentId = '';
      let ticking = false;

      function sync() {
        ticking = false;
        if (entries.length === 0) return;

        // 当前小节 = 最后一个已经滚过基准线的标题
        let idx = 0;
        for (let i = 0; i < entries.length; i++) {
          if (entries[i].el.getBoundingClientRect().top <= OFFSET) idx = i;
          else break;
        }
        // 到底了就直接点亮最后一节：否则末尾几节永远轮不到
        const atBottom =
          window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
        if (atBottom) idx = entries.length - 1;

        const id = entries[idx].link.getAttribute('href') ?? '';
        if (id === currentId) return;
        currentId = id;

        for (const e of entries) {
          const on = (e.link.getAttribute('href') ?? '') === id;
          e.link.classList.toggle('is-current', on);
          if (on) {
            e.link.setAttribute('aria-current', 'true');
            // 长目录自己会滚动：只动目录的 scrollTop，绝不去动页面滚动位置
            const box = tocEl.getBoundingClientRect();
            const r = e.link.getBoundingClientRect();
            if (r.top < box.top + 4 || r.bottom > box.bottom - 4) {
              tocEl.scrollTop += r.top - box.top - (box.height - r.height) / 2;
            }
          } else {
            e.link.removeAttribute('aria-current');
          }
        }
      }

      function schedule() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(sync);
      }

      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      sync();
    }
  </script>
</BaseLayout>

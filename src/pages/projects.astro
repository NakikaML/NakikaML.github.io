---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';

const statusColor: Record<string, string> = {
  进行中: 'var(--ok)',
  已完成: 'var(--text-faint)',
  筹备中: 'var(--warn)',
};
---

<BaseLayout title="项目" description="在做和做过的项目：数据库系统、竞赛训练、知识库工程。">
  <div class="wrap wrap--read">
    <div class="page-head">
      <p class="page-head__kicker">Projects</p>
      <h1>项目</h1>
      <p class="page-head__lede">
        课程之外真正动手做的东西。有些还在跑，有些已经交付。
      </p>
    </div>

    <div class="grid" style="grid-template-columns:1fr">
      {
        projects.map((p) => (
          <article class="card" style="cursor:default">
            <div style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap">
              <h2 style="font-size:1.15rem;margin:0;border:0;padding:0">{p.name}</h2>
              <span
                style={`font-size:0.75rem;font-weight:600;color:${statusColor[p.status] ?? 'var(--text-faint)'}`}
              >
                ● {p.status}
              </span>
            </div>

            <p style="margin:0.35rem 0 0;color:var(--text-muted);font-size:0.9rem">
              {p.tagline}
            </p>

            <p style="margin:0.7rem 0 0;font-size:0.925rem">{p.description}</p>

            <div class="tag-row" style="margin-top:0.85rem">
              {p.stack.map((s) => (
                <span class="tag">{s}</span>
              ))}
            </div>

            <div class="card__meta">
              <span>{p.role}</span>
              <span>· {p.period}</span>
              {p.link && (
                <a href={p.link} target="_blank" rel="noopener" style="margin-left:auto">
                  查看 →
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

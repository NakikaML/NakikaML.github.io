---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byDateDesc, fmtDate, excerpt } from '../../utils/notes';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort(byDateDesc);

const tagSet = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) tagSet.set(t, (tagSet.get(t) ?? 0) + 1);
const tags = [...tagSet.entries()].sort((a, b) => b[1] - a[1]).slice(0, 16);
---

<BaseLayout title="博客" description="手写长文：技术思考、学习复盘与创作记录。">
  <div class="wrap wrap--read">
    <div class="page-head">
      <p class="page-head__kicker">Blog</p>
      <h1>博客</h1>
      <p class="page-head__lede">
        和「笔记」不同，这里放的是完整的文章 —— 有头有尾的思考、复盘和踩坑记录。
      </p>
    </div>

    {
      tags.length > 0 && (
        <div class="tag-row" style="margin-bottom:2rem">
          {tags.map(([t, n]) => (
            <span class="tag">
              #{t} <span style="opacity:.6">{n}</span>
            </span>
          ))}
        </div>
      )
    }

    {
      posts.length === 0 ? (
        <div class="empty">
          还没有博客文章。在 <code>src/content/blog/</code> 下新建一个 <code>.md</code> 文件就能发布，
          格式参考该目录里的示例文章。
        </div>
      ) : (
        <div class="grid" style="grid-template-columns:1fr">
          {posts.map((post) => (
            <a class="card" href={`/blog/${post.id}/`}>
              <h3 class="card__title" style="font-size:1.15rem">
                {post.data.title}
              </h3>
              {post.data.description && <p class="card__desc">{post.data.description}</p>}
              <div class="card__meta">
                <time datetime={fmtDate(post.data.date)}>{fmtDate(post.data.date)}</time>
                {post.data.updated && <span>· 更新于 {fmtDate(post.data.updated)}</span>}
                {post.data.tags.length > 0 && (
                  <span style="margin-left:auto">
                    {post.data.tags.map((t) => (
                      <span class="tag" style="margin-left:0.3rem">
                        #{t}
                      </span>
                    ))}
                  </span>
                )}
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
